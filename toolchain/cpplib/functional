#ifndef PRIZM_CPPSHIM_FUNCTIONAL
#define PRIZM_CPPSHIM_FUNCTIONAL

/* <functional>.
 *
 * The comparator and arithmetic functors, unary_function / binary_function and
 * hash are in __stl_bits, because the ordered containers need less<> before
 * this header is ever included.  What is added here is what only user code
 * wants: reference_wrapper and a working std::function.
 */
#include <__stl_bits>
#include <type_traits>
#include <new>
#include <cstddef>   /* std::nullptr_t */

namespace std {

/* =====================================================================
   reference_wrapper - a callable that stands for a reference
   ===================================================================== */

template<class T>
class reference_wrapper {
public:
	typedef T type;

	explicit reference_wrapper(T& t) : m_p(&t) {}

	operator T&() const { return *m_p; }
	T& get() const { return *m_p; }

	template<class... Args>
	auto operator()(Args&&... a) const
	    -> decltype(__stl_declval<T&>()(forward<Args>(a)...)) {
		return (*m_p)(forward<Args>(a)...);
	}

private:
	T* m_p;
};

template<class T> inline reference_wrapper<T>       ref(T& t)  { return reference_wrapper<T>(t); }
template<class T> inline reference_wrapper<const T> cref(const T& t) { return reference_wrapper<const T>(t); }
template<class T> inline reference_wrapper<T>       ref(reference_wrapper<T> t) { return t; }

/* =====================================================================
   function

   A type erased callable.  Real std::function has a small object buffer and
   only reaches for the heap when the callable is too big for it; this one
   always allocates, which costs a malloc per function object and keeps the
   implementation short enough to be obviously correct.  Everything a console
   program does with std::function - store a function pointer, a lambda, a
   reference to a functor - works either way.

   There are no exceptions, so calling an empty function goes to
   prizm_stl_fatal instead of throwing bad_function_call.
   ===================================================================== */

template<class Signature> class function;

template<class R, class... Args>
class function<R(Args...)> {
private:
	struct __base {
		virtual ~__base() {}
		virtual R __call(Args... args) = 0;
		virtual __base* __clone() const = 0;
	};

	template<class F>
	struct __holder : __base {
		F m_f;
		explicit __holder(const F& f) : m_f(f) {}
		R __call(Args... args) { return m_f(static_cast<Args&&>(args)...); }
		__base* __clone() const { return new __holder(m_f); }
	};

	__base* m_p;

	/* Stops the forwarding constructor from hijacking copy construction of an
	   lvalue function<R(Args...)>, which would otherwise be an exact match. */
	template<class F>
	struct __is_self {
		static const bool value = is_same<typename decay<F>::type,
		                                  function<R(Args...)> >::value;
	};

	template<class F>
	void __install(F f) {
		delete m_p;
		m_p = new __holder<F>(f);
	}

public:
	typedef R result_type;

	function() : m_p(0) {}
	function(nullptr_t) : m_p(0) {}

	template<class F, class = typename enable_if<!__is_self<F>::value>::type>
	function(F f) : m_p(0) { __install(f); }

	function(const function& o) : m_p(o.m_p ? o.m_p->__clone() : 0) {}

	~function() { delete m_p; }

	function& operator=(const function& o) {
		if (this != &o) {
			delete m_p;
			m_p = o.m_p ? o.m_p->__clone() : 0;
		}
		return *this;
	}

	template<class F, class = typename enable_if<!__is_self<F>::value>::type>
	function& operator=(F f) { __install(f); return *this; }

	function& operator=(nullptr_t) { delete m_p; m_p = 0; return *this; }

	R operator()(Args... args) const {
		if (!m_p) {
			__stl_fail("std::function: called while empty");
			return R();
		}
		return m_p->__call(static_cast<Args&&>(args)...);
	}

	explicit operator bool() const { return m_p != 0; }
	bool operator!() const { return m_p == 0; }

	void swap(function& o) { __base* t = m_p; m_p = o.m_p; o.m_p = t; }
};

/* R() above only compiles when R is a value type.  For a void signature the
   early return has to be spelled differently, so the two void cases get their
   own specialisations that share everything else. */
template<class... Args>
class function<void(Args...)> {
private:
	struct __base {
		virtual ~__base() {}
		virtual void __call(Args... args) = 0;
		virtual __base* __clone() const = 0;
	};

	template<class F>
	struct __holder : __base {
		F m_f;
		explicit __holder(const F& f) : m_f(f) {}
		void __call(Args... args) { m_f(static_cast<Args&&>(args)...); }
		__base* __clone() const { return new __holder(m_f); }
	};

	__base* m_p;

	template<class F>
	struct __is_self {
		static const bool value = is_same<typename decay<F>::type,
		                                  function<void(Args...)> >::value;
	};

	template<class F>
	void __install(F f) {
		delete m_p;
		m_p = new __holder<F>(f);
	}

public:
	typedef void result_type;

	function() : m_p(0) {}
	function(nullptr_t) : m_p(0) {}

	template<class F, class = typename enable_if<!__is_self<F>::value>::type>
	function(F f) : m_p(0) { __install(f); }

	function(const function& o) : m_p(o.m_p ? o.m_p->__clone() : 0) {}

	~function() { delete m_p; }

	function& operator=(const function& o) {
		if (this != &o) {
			delete m_p;
			m_p = o.m_p ? o.m_p->__clone() : 0;
		}
		return *this;
	}

	template<class F, class = typename enable_if<!__is_self<F>::value>::type>
	function& operator=(F f) { __install(f); return *this; }

	function& operator=(nullptr_t) { delete m_p; m_p = 0; return *this; }

	void operator()(Args... args) const {
		if (!m_p) {
			__stl_fail("std::function: called while empty");
			return;
		}
		m_p->__call(static_cast<Args&&>(args)...);
	}

	explicit operator bool() const { return m_p != 0; }
	bool operator!() const { return m_p == 0; }

	void swap(function& o) { __base* t = m_p; m_p = o.m_p; o.m_p = t; }
};

template<class R, class... Args>
inline void swap(function<R(Args...)>& a, function<R(Args...)>& b) { a.swap(b); }

template<class R, class... Args>
inline bool operator==(const function<R(Args...)>& f, nullptr_t) { return !f; }
template<class R, class... Args>
inline bool operator==(nullptr_t, const function<R(Args...)>& f) { return !f; }
template<class R, class... Args>
inline bool operator!=(const function<R(Args...)>& f, nullptr_t) { return (bool)f; }
template<class R, class... Args>
inline bool operator!=(nullptr_t, const function<R(Args...)>& f) { return (bool)f; }

/* =====================================================================
   bind, mem_fn, not_fn, bind_front

   The binder stores its bound arguments in a tiny recursive tuple.  At
   call time every stored argument is evaluated: a plain value is passed
   through, a placeholder picks the matching call argument, a nested bind
   expression is invoked with no arguments and a reference_wrapper is
   unwrapped.  Everything is done by tag dispatch on __ev_kind so the
   overload set stays unambiguous.
   ===================================================================== */

namespace placeholders {
template<int N> struct ph {};
inline constexpr ph<1>  _1 {};
inline constexpr ph<2>  _2 {};
inline constexpr ph<3>  _3 {};
inline constexpr ph<4>  _4 {};
inline constexpr ph<5>  _5 {};
inline constexpr ph<6>  _6 {};
inline constexpr ph<7>  _7 {};
inline constexpr ph<8>  _8 {};
inline constexpr ph<9>  _9 {};
inline constexpr ph<10> _10 {};
}  /* namespace placeholders */

template<class T> struct is_placeholder       : integral_constant<int, 0> {};
template<int N>
struct is_placeholder<placeholders::ph<N> >   : integral_constant<int, N> {};

/* --- the mini tuple used to hold bound arguments --------------------- */

template<class... Ts> struct __btuple {};
template<> struct __btuple<> { enum { __len = 0 }; };

template<class T, class... Rest>
struct __btuple<T, Rest...> : __btuple<Rest...> {
	T m_val;
	enum { __len = 1 + (int)__btuple<Rest...>::__len };
	template<class U, class... URest>
	__btuple(U&& u, URest&&... r)
	    : __btuple<Rest...>(static_cast<URest&&>(r)...),
	      m_val(static_cast<U&&>(u)) {}
};

template<int I, class Tup> struct __bt_get;

template<class T, class... Rest>
struct __bt_get<0, __btuple<T, Rest...> > {
	typedef T type;
	static T& get(__btuple<T, Rest...>& t) { return t.m_val; }
};

template<int I, class T, class... Rest>
struct __bt_get<I, __btuple<T, Rest...> > {
	typedef typename __bt_get<I - 1, __btuple<Rest...> >::type type;
	static typename __bt_get<I - 1, __btuple<Rest...> >::type&
	get(__btuple<T, Rest...>& t) {
		return __bt_get<I - 1, __btuple<Rest...> >::get(
		    static_cast<__btuple<Rest...>&>(t));
	}
};

/* --- index pack so every bound argument can be expanded at once ------ */

template<int...> struct __idx {};
template<int N, int... Is> struct __mk_idx : __mk_idx<N - 1, N - 1, Is...> {};
template<int... Is> struct __mk_idx<0, Is...> { typedef __idx<Is...> type; };

/* --- evaluating one bound argument ----------------------------------- */

template<class B> struct __ev_kind { static const int v = 0; };  /* plain value */
template<int N> struct __ev_kind<placeholders::ph<N> > { static const int v = 1; };

/* nested bind expressions are invoked with the call arguments unpacked */
template<class B, class CTup, int... Is>
inline auto __unpack_call(B& b, CTup& cp, __idx<Is...>)
    -> decltype(b(__bt_get<Is, CTup>::get(cp)...))
{
	return b(__bt_get<Is, CTup>::get(cp)...);
}

template<int V> struct __ev_dispatch;

/* plain bound value: pass it through */
template<> struct __ev_dispatch<0> {
	template<class B, class CTup>
	static B& eval(B& b, CTup&) { return b; }
};

/* placeholder: pick the matching call argument from the call tuple */
template<> struct __ev_dispatch<1> {
	template<int N, class CTup>
	static typename __bt_get<N - 1, CTup>::type&
	eval(placeholders::ph<N>, CTup& cp) {
		return __bt_get<N - 1, CTup>::get(cp);
	}
};

/* nested bind expression: forward-declared here, defined below */
template<class F, class... BoundArgs> class __binder;
template<class F, class... BoundArgs>
struct __ev_kind<__binder<F, BoundArgs...> > { static const int v = 2; };

template<> struct __ev_dispatch<2> {
	template<class F2, class... BA, class CTup>
	static auto eval(__binder<F2, BA...>& b, CTup& cp)
	    -> decltype(__unpack_call(b, cp,
	        typename __mk_idx<CTup::__len>::type()))
	{
		return __unpack_call(b, cp, typename __mk_idx<CTup::__len>::type());
	}
};

/* reference_wrapper: unwrap */
template<> struct __ev_dispatch<3> {
	template<class T, class CTup>
	static T& eval(reference_wrapper<T> r, CTup&) { return r.get(); }
};

template<class B, class CTup>
inline auto __eval(B& b, CTup& cp)
    -> decltype(__ev_dispatch<__ev_kind<B>::v>::eval(b, cp))
{
	return __ev_dispatch<__ev_kind<B>::v>::eval(b, cp);
}

/* --- the binder itself ------------------------------------------------ */

template<class F, class... BoundArgs>
class __binder {
	typedef __btuple<typename decay<BoundArgs>::type...> __btp;
	typedef typename __mk_idx<sizeof...(BoundArgs)>::type __bidx;

	F m_f;
	__btp m_a;

	template<class CTup, int... Is>
	static auto __invoke(F& f, __btp& t, CTup& cp, __idx<Is...>)
	    -> decltype(f(__eval(__bt_get<Is, __btp>::get(t), cp)...))
	{
		return f(__eval(__bt_get<Is, __btp>::get(t), cp)...);
	}

public:
	__binder(F f, BoundArgs... b)
	    : m_f(f), m_a(static_cast<BoundArgs&&>(b)...) {}

	template<class... CArgs>
	auto operator()(CArgs... c)
	    -> decltype(__invoke(m_f, m_a,
	            __stl_declval<__btuple<CArgs...>&>(), __bidx()))
	{
		__btuple<CArgs...> cp(static_cast<CArgs&&>(c)...);
		return __invoke(m_f, m_a, cp, __bidx());
	}
};

template<class T> struct is_bind_expression            : false_type {};
template<class F, class... BA>
struct is_bind_expression<__binder<F, BA...> >         : true_type {};

template<class F, class... BoundArgs>
inline __binder<typename decay<F>::type, typename decay<BoundArgs>::type...>
bind(F&& f, BoundArgs&&... b) {
	return __binder<typename decay<F>::type,
	                typename decay<BoundArgs>::type...>(
	    static_cast<F&&>(f), static_cast<BoundArgs&&>(b)...);
}

/* --- bind_front: bound arguments before the call arguments, no
       placeholder handling ---------------------------------------------- */

template<class F, class... BoundArgs>
class __binder_front {
	typedef __btuple<typename decay<BoundArgs>::type...> __btp;
	typedef typename __mk_idx<sizeof...(BoundArgs)>::type __bidx;

	F m_f;
	__btp m_a;

	template<class CTup, int... Is, int... Js>
	static auto __invoke(F& f, __btp& t, CTup& cp, __idx<Is...>, __idx<Js...>)
	    -> decltype(f(__bt_get<Is, __btp>::get(t)...,
	                  __bt_get<Js, CTup>::get(cp)...))
	{
		return f(__bt_get<Is, __btp>::get(t)...,
		         __bt_get<Js, CTup>::get(cp)...);
	}

public:
	__binder_front(F f, BoundArgs... b)
	    : m_f(f), m_a(static_cast<BoundArgs&&>(b)...) {}

	template<class... CArgs>
	auto operator()(CArgs... c)
	    -> decltype(__invoke(m_f, m_a,
	            __stl_declval<__btuple<CArgs...>&>(), __bidx(),
	            typename __mk_idx<__btuple<CArgs...>::__len>::type()))
	{
		__btuple<CArgs...> cp(static_cast<CArgs&&>(c)...);
		return __invoke(m_f, m_a, cp, __bidx(),
		                typename __mk_idx<__btuple<CArgs...>::__len>::type());
	}
};

template<class F, class... BoundArgs>
inline __binder_front<typename decay<F>::type,
                      typename decay<BoundArgs>::type...>
bind_front(F&& f, BoundArgs&&... b) {
	return __binder_front<typename decay<F>::type,
	                      typename decay<BoundArgs>::type...>(
	    static_cast<F&&>(f), static_cast<BoundArgs&&>(b)...);
}

/* --- not_fn ------------------------------------------------------------ */

template<class F>
class __not_fn_t {
	F m_f;
public:
	explicit __not_fn_t(F f) : m_f(f) {}
	template<class... A>
	auto operator()(A... a) -> decltype(!m_f(static_cast<A&&>(a)...)) {
		return !m_f(static_cast<A&&>(a)...);
	}
};

template<class F>
inline __not_fn_t<typename decay<F>::type> not_fn(F&& f) {
	return __not_fn_t<typename decay<F>::type>(static_cast<F&&>(f));
}

/* --- mem_fn ------------------------------------------------------------ */

template<class C, class R, class... A>
class __memfn_mf {
	R (C::*m_p)(A...);
public:
	explicit __memfn_mf(R (C::*p)(A...)) : m_p(p) {}
	R operator()(C& c, A... a) const {
		return (c.*m_p)(static_cast<A&&>(a)...);
	}
	R operator()(C* c, A... a) const {
		return (c->*m_p)(static_cast<A&&>(a)...);
	}
};

template<class C, class R, class... A>
class __memfn_mfc {
	R (C::*m_p)(A...) const;
public:
	explicit __memfn_mfc(R (C::*p)(A...) const) : m_p(p) {}
	R operator()(const C& c, A... a) const {
		return (c.*m_p)(static_cast<A&&>(a)...);
	}
	R operator()(const C* c, A... a) const {
		return (c->*m_p)(static_cast<A&&>(a)...);
	}
};

template<class C, class R>
class __memfn_mo {
	R C::*m_p;
public:
	explicit __memfn_mo(R C::*p) : m_p(p) {}
	R& operator()(C& c) const { return c.*m_p; }
	R& operator()(C* c) const { return c->*m_p; }
};

template<class C, class R, class... A>
inline __memfn_mf<C, R, A...> mem_fn(R (C::*p)(A...)) {
	return __memfn_mf<C, R, A...>(p);
}

template<class C, class R, class... A>
inline __memfn_mfc<C, R, A...> mem_fn(R (C::*p)(A...) const) {
	return __memfn_mfc<C, R, A...>(p);
}

template<class C, class R>
inline __memfn_mo<C, R> mem_fn(R C::*p) {
	return __memfn_mo<C, R>(p);
}

}  /* namespace std */

#endif
