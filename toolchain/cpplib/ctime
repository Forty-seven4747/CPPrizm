#ifndef PRIZM_CPPSHIM_CTIME
#define PRIZM_CPPSHIM_CTIME

#include <time.h>

/* time.h has time_t and clock(), but no time() and no struct tm, so those are
   declared here and implemented in prizm_rt.cpp from the RTC. */
struct tm {
	int tm_sec;
	int tm_min;
	int tm_hour;
	int tm_mday;
	int tm_mon;
	int tm_year;
	int tm_wday;
	int tm_yday;
	int tm_isdst;
};

extern "C" {
time_t time(time_t* t);
struct tm* localtime(const time_t* t);
struct tm* gmtime(const time_t* t);
double difftime(time_t a, time_t b);
}

namespace std {
using ::time_t;
using ::clock_t;
using ::clock;
using ::time;
using ::localtime;
using ::gmtime;
using ::difftime;
}

#endif
