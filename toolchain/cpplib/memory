#ifndef PRIZM_CPPSHIM_MEMORY
#define PRIZM_CPPSHIM_MEMORY

/* <memory>.
 *
 * unique_ptr, shared_ptr, weak_ptr and the uninitialised-fill helpers.  The
 * allocator itself is in __stl_bits, because the containers need it before any
 * user header is included; what is added here is allocator_traits, the smart
 * pointers, and the standard-shaped aliases for the raw helpers.
 *
 * shared_ptr is a plain reference counted implementation: one control block
 * per object, strong and weak counters, virtual dispose/destroy.  There is no
 * single-allocation make_shared and no thread safety, neither of which means
 * anything on a single threaded calculator.
 *
 * Without exceptions a shared_ptr that runs empty is a programming error, not
 * a catchable event, so dereferencing a null one goes to prizm_stl_fatal - the
 * same bargain the rest of these headers make.
 */

#include <__stl_bits>
#include <type_traits>
#include <new>
#include <cstddef>

namespace std {

/* =====================================================================
   default_delete
   ===================================================================== */

template<class T> struct default_delete {
	default_delete() {}
	template<class U> default_delete(const default_delete<U>&) {}

	void operator()(T* p) const { delete p; }
	typedef T* pointer;
};

template<class T> struct default_delete<T[]> {
	default_delete() {}
	template<class U> default_delete(const default_delete<U[]>&) {}

	template<class U> void operator()(U* p) const { delete[] p; }
	typedef T* pointer;
};

/* =====================================================================
   unique_ptr
   ===================================================================== */

template<class T, class D = default_delete<T> > class unique_ptr;
template<class T> class shared_ptr;
template<class T> class weak_ptr;

template<class T, class D>
class unique_ptr {
public:
	typedef T  element_type;
	typedef D  deleter_type;
	typedef T* pointer;

	unique_ptr() : m_p(0), m_d() {}
	explicit unique_ptr(pointer p) : m_p(p), m_d() {}
	unique_ptr(pointer p, const D& d) : m_p(p), m_d(d) {}
	unique_ptr(pointer p, D&& d) : m_p(p), m_d(static_cast<D&&>(d)) {}

	unique_ptr(unique_ptr&& o) : m_p(o.m_p), m_d(static_cast<D&&>(o.m_d)) { o.m_p = 0; }

	/* Move from a unique_ptr with a compatible pointer type. */
	template<class U, class E>
	unique_ptr(unique_ptr<U, E>&& o) : m_p(o.release()), m_d(static_cast<E&&>(o.get_deleter())) {}

	unique_ptr& operator=(unique_ptr&& o) {
		if (this != &o) {
			__reset(o.release());
			m_d = static_cast<D&&>(o.m_d);
		}
		return *this;
	}

	/* A unique_ptr is not copyable; the standard deletes these, but naming
	   them here produces a readable diagnostic on this compiler. */
	unique_ptr(const unique_ptr&);
	unique_ptr& operator=(const unique_ptr&);

	~unique_ptr() { __reset(0); }

	pointer get() const { return m_p; }
	D& get_deleter() { return m_d; }
	const D& get_deleter() const { return m_d; }

	explicit operator bool() const { return m_p != 0; }

	/* Dereferencing a null unique_ptr is undefined behaviour, exactly as in
	   the standard, so operator* is left unchecked; operator-> can report
	   safely because it returns a pointer.
	   The return type is spelled add_lvalue_reference<T> rather than T& so
	   that unique_ptr<void> (a legal "handle" type) can still be declared. */
	typename add_lvalue_reference<T>::type operator*() const { return *m_p; }
	T* operator->() const {
		if (!m_p) { __stl_fail("unique_ptr: dereferenced while null"); return 0; }
		return m_p;
	}

	pointer release() { pointer p = m_p; m_p = 0; return p; }

	void reset(pointer p = pointer()) {
		pointer old = m_p;
		m_p = p;
		if (old) m_d(old);
	}

	void swap(unique_ptr& o) {
		pointer t = m_p; m_p = o.m_p; o.m_p = t;
		D td = static_cast<D&&>(m_d); m_d = static_cast<D&&>(o.m_d); o.m_d = static_cast<D&&>(td);
	}

private:
	pointer m_p;
	D       m_d;

	void __reset(pointer p) { if (m_p) m_d(m_p); m_p = p; }
};

/* ---- array form ------------------------------------------------------- */

template<class T, class D>
class unique_ptr<T[], D> {
public:
	typedef T  element_type;
	typedef D  deleter_type;
	typedef T* pointer;

	unique_ptr() : m_p(0), m_d() {}
	explicit unique_ptr(pointer p) : m_p(p), m_d() {}
	unique_ptr(pointer p, const D& d) : m_p(p), m_d(d) {}
	unique_ptr(pointer p, D&& d) : m_p(p), m_d(static_cast<D&&>(d)) {}
	unique_ptr(unique_ptr&& o) : m_p(o.m_p), m_d(static_cast<D&&>(o.m_d)) { o.m_p = 0; }

	unique_ptr& operator=(unique_ptr&& o) {
		if (this != &o) { __reset(o.release()); m_d = static_cast<D&&>(o.m_d); }
		return *this;
	}

	unique_ptr(const unique_ptr&);
	unique_ptr& operator=(const unique_ptr&);

	~unique_ptr() { __reset(0); }

	pointer get() const { return m_p; }
	D& get_deleter() { return m_d; }
	const D& get_deleter() const { return m_d; }
	explicit operator bool() const { return m_p != 0; }

	T& operator[](size_t i) const { return m_p[i]; }

	pointer release() { pointer p = m_p; m_p = 0; return p; }
	void reset(pointer p = pointer()) { pointer old = m_p; m_p = p; if (old) m_d(old); }
	void swap(unique_ptr& o) { pointer t = m_p; m_p = o.m_p; o.m_p = t; }

private:
	pointer m_p;
	D       m_d;

	void __reset(pointer p) { if (m_p) m_d(m_p); m_p = p; }
};

/* ---- comparisons (by address, as the standard specifies) -------------- */

template<class T, class D, class U, class E>
inline bool operator==(const unique_ptr<T, D>& a, const unique_ptr<U, E>& b) { return a.get() == b.get(); }
template<class T, class D, class U, class E>
inline bool operator!=(const unique_ptr<T, D>& a, const unique_ptr<U, E>& b) { return a.get() != b.get(); }
template<class T, class D> inline bool operator==(const unique_ptr<T, D>& a, nullptr_t) { return !a; }
template<class T, class D> inline bool operator==(nullptr_t, const unique_ptr<T, D>& a) { return !a; }
template<class T, class D> inline bool operator!=(const unique_ptr<T, D>& a, nullptr_t) { return (bool)a; }
template<class T, class D> inline bool operator!=(nullptr_t, const unique_ptr<T, D>& a) { return (bool)a; }

template<class T, class D, class U, class E>
inline bool operator<(const unique_ptr<T, D>& a, const unique_ptr<U, E>& b) { return a.get() < b.get(); }
template<class T, class D, class U, class E>
inline bool operator>(const unique_ptr<T, D>& a, const unique_ptr<U, E>& b) { return b.get() < a.get(); }
template<class T, class D, class U, class E>
inline bool operator<=(const unique_ptr<T, D>& a, const unique_ptr<U, E>& b) { return !(b < a); }
template<class T, class D, class U, class E>
inline bool operator>=(const unique_ptr<T, D>& a, const unique_ptr<U, E>& b) { return !(a < b); }

template<class T, class D>
inline void swap(unique_ptr<T, D>& a, unique_ptr<T, D>& b) { a.swap(b); }

/* ---- make_unique ------------------------------------------------------ */

template<class T, class... Args>
inline unique_ptr<T> make_unique(Args&&... args) {
	return unique_ptr<T>(new T(static_cast<Args&&>(args)...));
}

template<class T>
inline unique_ptr<T> make_unique(size_t n) {
	return unique_ptr<T>(new typename remove_extent<T>::type[n]());
}

/* =====================================================================
   shared_ptr / weak_ptr control block

   m_strong counts shared_ptr owners, m_weak counts weak_ptr owners plus one,
   the "this block is still in use" reference the counters themselves hold.
   When the last strong owner goes, __dispose is called and the extra weak
   reference is dropped; when the last weak owner goes, the block is deleted.
   ===================================================================== */

struct __sp_block_base {
	long m_strong;
	long m_weak;

	__sp_block_base() : m_strong(1), m_weak(1) {}
	virtual ~__sp_block_base() {}

	virtual void __dispose() = 0;
	virtual void __destroy() = 0;

	void __add_strong()     { ++m_strong; }
	void __add_weak()       { ++m_weak; }
	void __release_strong() {
		if (--m_strong == 0) {
			__dispose();
			__release_weak();
		}
	}
	void __release_weak() {
		if (--m_weak == 0) __destroy();
	}
};

template<class T, class D>
struct __sp_block : __sp_block_base {
	T* m_p;
	D  m_d;

	__sp_block(T* p, const D& d) : m_p(p), m_d(d) {}
	void __dispose() { if (m_p) m_d(m_p); m_p = 0; }
	void __destroy() { delete this; }
};

/* A block that owns a T allocated with plain new. */
template<class T, class D>
inline __sp_block_base* __sp_make_block(T* p, const D& d) {
	return new __sp_block<T, D>(p, d);
}

/* =====================================================================
   weak_ptr
   ===================================================================== */

/* enable_shared_from_this.  Declared before shared_ptr so the constructor of
   shared_ptr can name it. */
template<class T>
class enable_shared_from_this {
protected:
	enable_shared_from_this() {}
	enable_shared_from_this(const enable_shared_from_this&) {}
	enable_shared_from_this& operator=(const enable_shared_from_this&) { return *this; }
	~enable_shared_from_this() {}

public:
	shared_ptr<T> shared_from_this();
	shared_ptr<const T> shared_from_this() const;
	weak_ptr<T> weak_from_this() { return m_this; }
	weak_ptr<const T> weak_from_this() const { return m_this; }

	mutable weak_ptr<T> m_this;
};

template<class T>
class weak_ptr {
public:
	typedef T element_type;

	weak_ptr() : m_p(0), m_b(0) {}

	weak_ptr(const weak_ptr& o) : m_p(o.m_p), m_b(o.m_b) { if (m_b) m_b->__add_weak(); }
	weak_ptr(const shared_ptr<T>& o) : m_p(0), m_b(0) { __share(o); }

	template<class U>
	weak_ptr(const shared_ptr<U>& o) : m_p(0), m_b(0) { __share(o); }

	/* Converting constructor, so weak_ptr<Derived> -> weak_ptr<Base>. */
	template<class U>
	weak_ptr(const weak_ptr<U>& o) : m_p(0), m_b(0) { __share_weak(o); }

	~weak_ptr() { if (m_b) m_b->__release_weak(); }

	weak_ptr& operator=(const weak_ptr& o) {
		if (this != &o) { weak_ptr t(o); swap(t); }
		return *this;
	}
	weak_ptr& operator=(const shared_ptr<T>& o) { weak_ptr t(o); swap(t); return *this; }

	void reset() { weak_ptr t; swap(t); }

	long use_count() const { return m_b ? m_b->m_strong : 0; }
	bool expired() const { return !m_b || m_b->m_strong == 0; }

	shared_ptr<T> lock() const;

	void swap(weak_ptr& o) {
		T* a = m_p; m_p = o.m_p; o.m_p = a;
		__sp_block_base* b = m_b; m_b = o.m_b; o.m_b = b;
	}

	/* owner_before: only the control block matters, so ordering by it is
	   enough to build a map keyed on a weak_ptr. */
	template<class U> bool owner_before(const weak_ptr<U>& o) const { return m_b < o.m_b; }
	template<class U> bool owner_before(const shared_ptr<U>& o) const { return m_b < o.__block(); }

private:
	/* Raw pointers; the block reference is managed explicitly.  m_p is kept
	   only so a derived-to-base offset is not lost, and is valid exactly as
	   long as the block is. */
	T*               m_p;
	__sp_block_base* m_b;

	template<class U> void __share(const shared_ptr<U>& o) {
		m_p = static_cast<T*>(o.get());
		m_b = o.__block();
		if (m_b) m_b->__add_weak();
	}
	template<class U> void __share_weak(const weak_ptr<U>& o) {
		m_p = static_cast<T*>(o.m_p);
		m_b = o.m_b;
		if (m_b) m_b->__add_weak();
	}

	friend class shared_ptr<T>;
	template<class U> friend class shared_ptr;
	template<class U> friend class weak_ptr;
};

/* =====================================================================
   shared_ptr
   ===================================================================== */

template<class T>
class shared_ptr {
public:
	typedef T element_type;

	shared_ptr() : m_p(0), m_b(0) {}

	/* From a raw pointer: takes ownership. */
	template<class U>
	explicit shared_ptr(U* p) : m_p(p), m_b(p ? __sp_make_block(p, default_delete<U>()) : 0) {
		__enable(p);
	}
	shared_ptr(nullptr_t) : m_p(0), m_b(0) {}

	template<class U, class D>
	shared_ptr(U* p, D d) : m_p(p), m_b(p ? __sp_make_block(p, d) : 0) {}

	template<class U>
	shared_ptr(const shared_ptr<U>& o, T* p) : m_p(p), m_b(o.m_b) {
		if (m_b) m_b->__add_strong();
	}

	template<class U>
	shared_ptr(const shared_ptr<U>& o) : m_p(static_cast<T*>(o.get())), m_b(o.m_b) {
		if (m_b) m_b->__add_strong();
	}

	shared_ptr(const shared_ptr& o) : m_p(o.m_p), m_b(o.m_b) { if (m_b) m_b->__add_strong(); }
	shared_ptr(shared_ptr&& o) : m_p(o.m_p), m_b(o.m_b) { o.m_p = 0; o.m_b = 0; }

	template<class U>
	shared_ptr(shared_ptr<U>&& o) : m_p(static_cast<T*>(o.get())), m_b(o.__block()) {
		o.__clear();
	}

	/* Lend a weak_ptr into a shared_ptr. */
	template<class U>
	explicit shared_ptr(const weak_ptr<U>& w) : m_p(0), m_b(0) {
		if (!w.expired()) {
			m_b = w.m_b;
			m_p = static_cast<T*>(w.m_p);
			m_b->__add_strong();
		}
	}

	~shared_ptr() { if (m_b) m_b->__release_strong(); }

	shared_ptr& operator=(const shared_ptr& o) {
		if (this != &o) { shared_ptr t(o); swap(t); }
		return *this;
	}
	shared_ptr& operator=(shared_ptr&& o) {
		if (this != &o) { shared_ptr t(static_cast<shared_ptr&&>(o)); swap(t); }
		return *this;
	}
	template<class U> shared_ptr& operator=(const shared_ptr<U>& o) {
		shared_ptr t(o); swap(t); return *this;
	}
	shared_ptr& operator=(nullptr_t) { reset(); return *this; }

	void reset() { shared_ptr t; swap(t); }
	template<class U> void reset(U* p) {
		shared_ptr t(p);
		swap(t);
	}

	T* get() const { return m_p; }
	/* add_lvalue_reference<T> so shared_ptr<void> can be declared, which is
	   the usual way to hold a type erased owner. */
	typename add_lvalue_reference<T>::type operator*() const { return *m_p; }
	T* operator->() const {
		if (!m_p) { __stl_fail("shared_ptr: dereferenced while null"); return 0; }
		return m_p;
	}

	long use_count() const { return m_b ? m_b->m_strong : 0; }
	bool unique() const { return use_count() == 1; }
	explicit operator bool() const { return m_p != 0; }

	void swap(shared_ptr& o) {
		T* a = m_p; m_p = o.m_p; o.m_p = a;
		__sp_block_base* b = m_b; m_b = o.m_b; o.m_b = b;
	}

	template<class U> bool owner_before(const shared_ptr<U>& o) const { return m_b < o.__block(); }
	template<class U> bool owner_before(const weak_ptr<U>& o) const { return m_b < o.m_b; }

	__sp_block_base* __block() const { return m_b; }
	void __clear() { m_p = 0; m_b = 0; }

private:
	T*               m_p;
	__sp_block_base* m_b;

	/* If the object is enable_shared_from_this<T> (or derives from it), hand it
	   a weak reference to its own control block - that is what makes
	   shared_from_this() work.  The test is against enable_shared_from_this<T>,
	   not <U>, so shared_ptr<Base> b(new Derived) still installs the link when
	   Derived inherits enable_shared_from_this<Base>. */
	template<class U>
	void __enable_impl(U* p, true_type) { if (p) p->m_this = *this; }
	template<class U>
	void __enable_impl(U*, false_type) {}
	template<class U>
	void __enable(U* p) {
		__enable_impl(p, integral_constant<bool,
		              is_base_of<enable_shared_from_this<T>, U>::value>());
	}

	/* The two-argument and block-taking constructors need to install a block
	   that was already built. */
	shared_ptr(T* p, __sp_block_base* b) : m_p(p), m_b(b) { __enable(p); }

	template<class U, class... Args>
	friend shared_ptr<U> make_shared(Args&&... args);
	friend class weak_ptr<T>;
	template<class U> friend class weak_ptr;
	template<class U> friend class shared_ptr;
};

/* ---- weak_ptr::lock and enable_shared_from_this bodies ---------------- */

template<class T>
inline shared_ptr<T> weak_ptr<T>::lock() const {
	if (expired()) return shared_ptr<T>();
	return shared_ptr<T>(*this);
}

template<class T>
inline shared_ptr<T> enable_shared_from_this<T>::shared_from_this() {
	return m_this.lock();
}
template<class T>
inline shared_ptr<const T> enable_shared_from_this<T>::shared_from_this() const {
	return m_this.lock();
}

/* ---- make_shared ------------------------------------------------------ */

template<class U, class... Args>
inline shared_ptr<U> make_shared(Args&&... args) {
	U* p = new U(static_cast<Args&&>(args)...);
	shared_ptr<U> r(p, __sp_make_block(p, default_delete<U>()));
	return r;
}

/* ---- comparisons ------------------------------------------------------ */

template<class T, class U>
inline bool operator==(const shared_ptr<T>& a, const shared_ptr<U>& b) { return a.get() == b.get(); }
template<class T, class U>
inline bool operator!=(const shared_ptr<T>& a, const shared_ptr<U>& b) { return a.get() != b.get(); }
template<class T, class U>
inline bool operator<(const shared_ptr<T>& a, const shared_ptr<U>& b) { return a.get() < b.get(); }
template<class T> inline bool operator==(const shared_ptr<T>& a, nullptr_t) { return !a; }
template<class T> inline bool operator==(nullptr_t, const shared_ptr<T>& a) { return !a; }
template<class T> inline bool operator!=(const shared_ptr<T>& a, nullptr_t) { return (bool)a; }
template<class T> inline bool operator!=(nullptr_t, const shared_ptr<T>& a) { return (bool)a; }

template<class T>
inline void swap(shared_ptr<T>& a, shared_ptr<T>& b) { a.swap(b); }
template<class T>
inline void swap(weak_ptr<T>& a, weak_ptr<T>& b) { a.swap(b); }

/* ---- casts ------------------------------------------------------------ */

/* No RTTI on this target, so a dynamic_pointer_cast cannot check anything at
   run time.  It is provided so that code which names it still compiles and
   does the obvious static_cast; a genuinely down cast then has to be right by
   construction. */
template<class T, class U>
inline shared_ptr<T> static_pointer_cast(const shared_ptr<U>& p) {
	return shared_ptr<T>(p, static_cast<T*>(p.get()));
}
template<class T, class U>
inline shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U>& p) {
	return shared_ptr<T>(p, static_cast<T*>(p.get()));
}
template<class T, class U>
inline shared_ptr<T> reinterpret_pointer_cast(const shared_ptr<U>& p) {
	return shared_ptr<T>(p, reinterpret_cast<T*>(p.get()));
}
template<class T, class U>
inline shared_ptr<T> const_pointer_cast(const shared_ptr<U>& p) {
	return shared_ptr<T>(p, const_cast<T*>(p.get()));
}

template<class T, class U>
inline unique_ptr<T> static_pointer_cast(unique_ptr<U>&& p) {
	return unique_ptr<T>(static_cast<T*>(p.release()));
}
template<class T, class U>
inline unique_ptr<T> dynamic_pointer_cast(unique_ptr<U>&& p) {
	return unique_ptr<T>(static_cast<T*>(p.release()));
}
template<class T, class U>
inline unique_ptr<T> reinterpret_pointer_cast(unique_ptr<U>&& p) {
	return unique_ptr<T>(reinterpret_cast<T*>(p.release()));
}

/* =====================================================================
   pointer_traits
   ===================================================================== */

template<class Ptr> struct pointer_traits {
	typedef Ptr              pointer;
	typedef typename Ptr::element_type element_type;
	typedef typename Ptr::difference_type difference_type;

	template<class U> using rebind = typename Ptr::template rebind<U>;

	static pointer pointer_to(element_type& r) { return Ptr::pointer_to(r); }
};

template<class T> struct pointer_traits<T*> {
	typedef T*            pointer;
	typedef T             element_type;
	typedef ptrdiff_t     difference_type;

	template<class U> using rebind = U*;

	static pointer pointer_to(element_type& r) { return addressof(r); }
};

/* =====================================================================
   allocator_traits
   ===================================================================== */

template<class A> struct allocator_traits {
	typedef A                            allocator_type;
	typedef typename A::value_type       value_type;
	typedef value_type*                  pointer;
	typedef const value_type*            const_pointer;
	typedef value_type&                  reference;
	typedef const value_type&            const_reference;
	typedef size_t                       size_type;
	typedef ptrdiff_t                    difference_type;

	template<class U> struct rebind_alloc {
		typedef typename A::template rebind<U>::other other;
	};
	template<class U> using rebind_traits = allocator_traits<rebind_alloc<U> >;

	static pointer allocate(A& a, size_type n) { return a.allocate(n); }
	static pointer allocate(A& a, size_type n, const void*) { return a.allocate(n); }
	static void deallocate(A& a, pointer p, size_type n) { a.deallocate(p, n); }

	template<class U, class... Args>
	static void construct(A&, U* p, Args&&... args) { ::new (static_cast<void*>(p)) U(static_cast<Args&&>(args)...); }
	template<class U>
	static void destroy(A&, U* p) { p->~U(); }

	static size_type max_size(const A&) { return (size_type)-1 / sizeof(value_type); }

	/* is_always_equal: every allocator in these headers is stateless. */
	typedef true_type is_always_equal;
};

/* =====================================================================
   uninitialised algorithms (standard names over the __stl_ helpers)
   ===================================================================== */

template<class It, class T>
inline void uninitialized_fill(It first, It last, const T& v) {
	for (; first != last; ++first) __stl_construct(&*first, v);
}
template<class It, class Size, class T>
inline It uninitialized_fill_n(It first, Size n, const T& v) {
	return __stl_uninit_fill_n(&*first, (size_t)n, v);
}
template<class It, class T>
inline void uninitialized_copy(const It first, const It last, T* out) {
	__stl_uninit_copy_n(out, &*first, (size_t)(last - first));
}
template<class It, class Size, class T>
inline T* uninitialized_copy_n(It first, Size n, T* out) {
	__stl_uninit_copy_n(out, &*first, (size_t)n);
}
template<class It>
inline void uninitialized_default_construct(It first, It last) {
	for (; first != last; ++first) ::new (static_cast<void*>(&*first)) typename iterator_traits<It>::value_type;
}
template<class It, class Size>
inline It uninitialized_default_construct_n(It first, Size n) {
	for (; n > 0; ++first, --n) ::new (static_cast<void*>(&*first)) typename iterator_traits<It>::value_type;
	return first;
}
template<class It>
inline void uninitialized_value_construct(It first, It last) {
	typedef typename iterator_traits<It>::value_type V;
	for (; first != last; ++first) ::new (static_cast<void*>(&*first)) V();
}
template<class It, class Size>
inline It uninitialized_value_construct_n(It first, Size n) {
	typedef typename iterator_traits<It>::value_type V;
	for (; n > 0; ++first, --n) ::new (static_cast<void*>(&*first)) V();
	return first;
}

template<class T> inline void destroy_at(T* p) { p->~T(); }
template<class It> inline void destroy(It first, It last) {
	for (; first != last; ++first) __stl_destroy(&*first);
}
template<class It, class Size> inline It destroy_n(It first, Size n) {
	for (; n > 0; ++first, --n) __stl_destroy(&*first);
	return first;
}
/* Pointer overloads, so destroy(v.begin(), v.end()) from a vector still picks
   the fast path. */
template<class T> inline void destroy(T* first, T* last) { __stl_destroy_range(first, last); }

/* =====================================================================
   align (C++11) and friends
   ===================================================================== */

/* Standard std::align: if `size` bytes aligned to `alignment` fit in the
   `space` bytes at `ptr`, move ptr up to the aligned address and return it,
   charging only the padding against space.  Otherwise return null and leave
   both untouched. */
inline void* align(size_t alignment, size_t size, void*& ptr, size_t& space) {
	size_t addr = reinterpret_cast<size_t>(ptr);
	size_t mis  = addr % alignment;
	size_t pad  = mis ? (alignment - mis) : 0;
	if (pad > space || size > space - pad) return 0;
	void* r = reinterpret_cast<char*>(ptr) + pad;
	ptr = r;
	space -= pad;
	return r;
}

/* assume_aligned is a hint; with no other contract it is the identity. */
template<size_t N, class T>
inline constexpr T* assume_aligned(T* p) { return p; }

