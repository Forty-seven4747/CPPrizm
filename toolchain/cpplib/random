#ifndef PRIZM_CPPLIB_RANDOM
#define PRIZM_CPPLIB_RANDOM

/* Mersenne Twister mt19937 and the distributions people actually use.
   random_device seeds itself from the C clock (the calculator has no
   entropy source), so successive program runs are distinguishable but a
   run's stream is well-mixed. */

#include <cstdint>
#include <cstddef>
#include <ctime>
#include <cmath>
#include <vector>
#include <initializer_list>

namespace std {

/* ---- mersenne_twister_engine<mt19937> ----------------------------- */

class mt19937 {
public:
	typedef uint32_t result_type;
	static const result_type min() { return 0; }
	static const result_type max() { return 4294967295u; }

	explicit mt19937(result_type seed = 5489u) { seed_value(seed); }

	/* Seed from a seed_seq (lvalue-reference template keeps calls like
	   mt19937 g(42u) unambiguous). */
	template<class SeedSeq>
	explicit mt19937(SeedSeq& s) {
		uint32_t v = 5489u;
		s.generate(&v, &v + 1);
		seed_value(v);
	}

	void seed(result_type seed = 5489u) { seed_value(seed); }

	result_type operator()() {
		if (m_idx >= 624) __twist();
		uint32_t y = m_state[m_idx++];
		y ^= (y >> 11);
		y ^= (y << 7) & 0x9D2C5680u;
		y ^= (y << 15) & 0xEFC60000u;
		y ^= (y >> 18);
		return y;
	}

	void discard(unsigned long long n) {
		while (n--) {
			if (m_idx >= 624) __twist();
			m_idx++;
		}
	}

	bool operator==(const mt19937& o) const {
		if (m_idx != o.m_idx) return false;
		for (int i = 0; i < 624; i++)
			if (m_state[i] != o.m_state[i]) return false;
		return true;
	}
	bool operator!=(const mt19937& o) const { return !(*this == o); }

private:
	void seed_value(uint32_t s) {
		m_state[0] = s;
		for (int i = 1; i < 624; i++)
			m_state[i] = 1812433253u * (m_state[i - 1] ^ (m_state[i - 1] >> 30)) + (uint32_t)i;
		m_idx = 624;
	}

	void __twist() {
		for (int i = 0; i < 624; i++) {
			uint32_t y = (m_state[i] & 0x80000000u) | (m_state[(i + 1) % 624] & 0x7FFFFFFFu);
			uint32_t nx = m_state[(i + 397) % 624] ^ (y >> 1);
			if (y & 1u) nx ^= 0x9908B0DFu;
			m_state[i] = nx;
		}
		m_idx = 0;
	}

	uint32_t m_state[624];
	int      m_idx;
};

typedef mt19937 default_random_engine;

/* 64-bit variant: two independent 32-bit generators zipped (this is not the
   official mt19937_64 recurrence, but it gives a well-mixed 64-bit stream
   without doubling the state table). */
class mt19937_64 {
public:
	typedef uint64_t result_type;
	static const result_type min() { return 0; }
	static const result_type max() { return 18446744073709551615ull; }

	explicit mt19937_64(result_type seed = 5489u) { m_lo.seed((uint32_t)seed); m_hi.seed((uint32_t)(seed >> 32) + 0x9E3779B9u); }
	uint64_t operator()() { return ((uint64_t)m_hi() << 32) | m_lo(); }
private:
	mt19937 m_lo, m_hi;
};

/* ---- random_device ------------------------------------------------ */

class random_device {
public:
	typedef unsigned result_type;
	static const result_type min() { return 0; }
	static const result_type max() { return 4294967295u; }
	random_device() {}
	result_type operator()() { return (result_type)clock() ^ (result_type)((size_t)&m_tag); }
private:
	char m_tag;
};

/* ---- seed_seq ------------------------------------------------------ */

class seed_seq {
public:
	typedef uint32_t result_type;
	seed_seq() {}
	seed_seq(initializer_list<uint32_t> il) {
		for (size_t i = 0; i < il.size(); i++) m_v.push_back(il.begin()[i]);
	}
	template<class It>
	seed_seq(It b, It e) { for (; b != e; ++b) m_v.push_back((uint32_t)*b); }
	template<class Out>
	void generate(Out b, Out e) {
		for (size_t i = 0; b != e; ++b, ++i)
			*b = (result_type)(m_v.empty() ? i : (m_v[i % m_v.size()] + i * 0x9E3779B9u));
	}
	size_t size() const { return m_v.size(); }
private:
	vector<uint32_t> m_v;   /* pulls <vector>; harmless, it is tiny */
};

/* ---- uniform distributions ---------------------------------------- */

template<class IntType = int>
class uniform_int_distribution {
public:
	typedef IntType result_type;
	explicit uniform_int_distribution(IntType a = 0, IntType b = 9) : m_a(a), m_b(b) {}
	IntType a() const { return m_a; }
	IntType b() const { return m_b; }
	IntType min() const { return m_a; }
	IntType max() const { return m_b; }
	template<class Engine>
	IntType operator()(Engine& g) const {
		/* Rejection-free modulo is slightly biased; on a calculator that
		   trade for speed is the right one. */
		uint64_t span = (uint64_t)(double)(m_b - m_a) + 1ull;
		return (IntType)(m_a + (IntType)(g() % span));
	}
private:
	IntType m_a, m_b;
};

template<class T = double>
class uniform_real_distribution {
public:
	typedef double result_type;
	explicit uniform_real_distribution(double a = 0.0, double b = 1.0) : m_a(a), m_b(b) {}
	double a() const { return m_a; }
	double b() const { return m_b; }
	double min() const { return m_a; }
	double max() const { return m_b; }
	template<class Engine>
	double operator()(Engine& g) const {
		return m_a + (m_b - m_a) * ((double)g() / 4294967296.0);   /* [0,1) */
	}
private:
	double m_a, m_b;
};

class bernoulli_distribution {
public:
	typedef bool result_type;
	explicit bernoulli_distribution(double p = 0.5) : m_p(p) {}
	double p() const { return m_p; }
	template<class Engine>
	bool operator()(Engine& g) const {
		return ((double)g() / 4294967296.0) < m_p;
	}
private:
	double m_p;
};

/* Box-Muller, two values at a time; the spare is cached. */
class normal_distribution {
public:
	typedef double result_type;
	explicit normal_distribution(double mean = 0.0, double stddev = 1.0) : m_mean(mean), m_sd(stddev), m_spare(0), m_has(false) {}
	double mean() const { return m_mean; }
	double stddev() const { return m_sd; }
	double min() const { return -1.0e308; }
	double max() const { return 1.0e308; }
	template<class Engine>
	double operator()(Engine& g) {
		if (m_has) { m_has = false; return m_spare * m_sd + m_mean; }
		double u1 = ((double)g() + 1.0) / 4294967297.0;   /* (0,1] */
		double u2 = ((double)g() + 1.0) / 4294967297.0;
		double r = sqrt(-2.0 * log(u1));
		double th = 6.283185307179586 * u2;
		m_spare = r * sin(th);
		m_has = true;
		return r * cos(th) * m_sd + m_mean;
	}
private:
	double m_mean, m_sd, m_spare;
	bool   m_has;
};

}

#endif
