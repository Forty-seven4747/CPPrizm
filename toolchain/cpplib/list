#ifndef PRIZM_CPPSHIM_LIST
#define PRIZM_CPPSHIM_LIST

/* <list>.
 *
 * Doubly linked list with a sentinel head node, which is the design libstdc++
 * uses: end() is the sentinel, so every node is reachable and push_back /
 * push_front never have to test for an empty list, and no operation
 * invalidates a reference to a live element except erasing it.
 *
 * The sentinel is a __list_node_base (two pointers, no T), and the real nodes
 * derive from it, so the iterator only ever sees the base type and the value
 * is recovered by casting to __list_node<T> - one static_cast, no offset
 * arithmetic, and an empty list costs exactly the sentinel.
 *
 * size() is kept as a counter, as C++11 requires it to be O(1).
 *
 * On allocation failure the list is left as it was and the operation reports
 * through prizm_stl_fatal.
 */

#include <__stl_bits>
#include <type_traits>
#include <initializer_list>
#include <algorithm>
#include <new>
#include <cstddef>

namespace std {

struct __list_node_base {
	__list_node_base* m_prev;
	__list_node_base* m_next;
	__list_node_base() : m_prev(this), m_next(this) {}
};

template<class T>
struct __list_node : __list_node_base {
	T m_v;
	template<class U>
	explicit __list_node(U&& u) : m_v(static_cast<U&&>(u)) {}
};

template<class T, class A = allocator<T> >
class list {
public:
	typedef T          value_type;
	typedef A          allocator_type;
	typedef size_t     size_type;
	typedef ptrdiff_t  difference_type;
	typedef T&         reference;
	typedef const T&   const_reference;
	typedef T*         pointer;
	typedef const T*   const_pointer;

	/* ---- iterators --------------------------------------------------- */

	template<class B, class Ref, class Ptr2>
	class __iter {
	public:
		typedef T                          value_type;
		typedef bidirectional_iterator_tag iterator_category;
		typedef ptrdiff_t                  difference_type;
		typedef Ptr2                       pointer;
		typedef Ref                        reference;

		__iter() : m_n(0) {}
		explicit __iter(B* n) : m_n(n) {}

		/* Allow iterator -> const_iterator. */
		template<class B2, class R2, class P2> friend class __iter;
		template<class B2, class R2, class P2>
		__iter(const __iter<B2, R2, P2>& o) : m_n(o.m_n) {}

		Ref operator*() const { return static_cast<__list_node<T>*>(m_n)->m_v; }
		Ptr2 operator->() const { return &static_cast<__list_node<T>*>(m_n)->m_v; }

		__iter& operator++() { m_n = m_n->m_next; return *this; }
		__iter operator++(int) { __iter t(*this); m_n = m_n->m_next; return t; }
		__iter& operator--() { m_n = m_n->m_prev; return *this; }
		__iter operator--(int) { __iter t(*this); m_n = m_n->m_prev; return t; }

		bool operator==(const __iter& o) const { return m_n == o.m_n; }
		bool operator!=(const __iter& o) const { return m_n != o.m_n; }

		B* __node() const { return m_n; }

	private:
		B* m_n;
	};

	/* Both iterator flavours hold a plain __list_node_base*, so the
	   iterator -> const_iterator conversion is a plain copy and there is no
	   const_cast anywhere.  const_iterator differs only in what operator*
	   hands back. */
	typedef __iter<__list_node_base, T&, T*>             iterator;
	typedef __iter<__list_node_base, const T&, const T*> const_iterator;
	typedef std::reverse_iterator<iterator>              reverse_iterator;
	typedef std::reverse_iterator<const_iterator>        const_reverse_iterator;

	/* ---- construction ----------------------------------------------- */

	list() : m_size(0) {}

	explicit list(size_type n) : m_size(0) { __fill(n, T()); }
	list(size_type n, const T& v) : m_size(0) { __fill(n, v); }

	template<class It, class = typename enable_if<!is_integral<It>::value>::type>
	list(It first, It last) : m_size(0) { for (; first != last; ++first) push_back(*first); }

	list(const list& o) : m_size(0) {
		for (const_iterator it = o.begin(); it != o.end(); ++it) push_back(*it);
	}
	list(list&& o) : m_size(o.m_size) {
		if (o.m_size) { __hook(&m_head, o.m_head.m_next, &o.m_head); o.__clear_nodes(); }
		o.m_size = 0;
	}

	list(std::initializer_list<T> il) : m_size(0) {
		for (const T* p = il.begin(); p != il.end(); ++p) push_back(*p);
	}

	~list() { __clear_nodes(); }

	list& operator=(const list& o) {
		if (this != &o) { list t(o); swap(t); }
		return *this;
	}
	list& operator=(list&& o) {
		if (this != &o) { list t(static_cast<list&&>(o)); swap(t); }
		return *this;
	}
	list& operator=(std::initializer_list<T> il) {
		list t(il); swap(t); return *this;
	}

	void assign(size_type n, const T& v) { list t(n, v); swap(t); }
	template<class It, class = typename enable_if<!is_integral<It>::value>::type>
	void assign(It first, It last) { list t(first, last); swap(t); }
	void assign(std::initializer_list<T> il) { list t(il); swap(t); }

	allocator_type get_allocator() const { return allocator_type(); }

	/* ---- element access --------------------------------------------- */

	reference       front()       { return static_cast<__list_node<T>*>(m_head.m_next)->m_v; }
	const_reference front() const { return static_cast<__list_node<T>*>(m_head.m_next)->m_v; }
	reference       back()        { return static_cast<__list_node<T>*>(m_head.m_prev)->m_v; }
	const_reference back()  const { return static_cast<__list_node<T>*>(m_head.m_prev)->m_v; }

	/* ---- iteration -------------------------------------------------- */

	iterator begin() { return iterator(m_head.m_next); }
	iterator end()   { return iterator(&m_head); }
	const_iterator begin()  const { return const_iterator(m_head.m_next); }
	const_iterator end()    const { return const_iterator(__head()); }
	const_iterator cbegin() const { return const_iterator(m_head.m_next); }
	const_iterator cend()   const { return const_iterator(__head()); }

	reverse_iterator       rbegin()        { return reverse_iterator(end()); }
	reverse_iterator       rend()          { return reverse_iterator(begin()); }
	const_reverse_iterator rbegin()  const { return const_reverse_iterator(end()); }
	const_reverse_iterator rend()    const { return const_reverse_iterator(begin()); }

	/* ---- size ------------------------------------------------------- */

	bool      empty() const { return m_size == 0; }
	size_type size()  const { return m_size; }
	size_type max_size() const { return (size_type)-1 / sizeof(__list_node<T>); }

	/* ---- modifiers -------------------------------------------------- */

	void clear() { __clear_nodes(); m_size = 0; }

	iterator insert(iterator pos, const T& v) {
		return iterator(__new_node(v, pos.__node()));
	}
	iterator insert(iterator pos, T&& v) {
		return iterator(__new_node(static_cast<T&&>(v), pos.__node()));
	}
	iterator insert(iterator pos, size_type n, const T& v) {
		iterator r = pos;
		for (size_type i = 0; i < n; i++) { pos = insert(pos, v); ++pos; }
		return r;
	}
	template<class It, class = typename enable_if<!is_integral<It>::value>::type>
	iterator insert(iterator pos, It first, It last) {
		iterator r = pos;
		for (; first != last; ++first) { pos = insert(pos, *first); ++pos; }
		return r;
	}
	iterator insert(iterator pos, std::initializer_list<T> il) {
		return insert(pos, il.begin(), il.end());
	}

	template<class... Args>
	iterator emplace(iterator pos, Args&&... args) {
		T tmp(static_cast<Args&&>(args)...);
		return iterator(__new_node(static_cast<T&&>(tmp), pos.__node()));
	}

	template<class... Args>
	reference emplace_back(Args&&... args) {
		T tmp(static_cast<Args&&>(args)...);
		iterator it = iterator(__new_node(static_cast<T&&>(tmp), &m_head));
		return *it;
	}
	template<class... Args>
	reference emplace_front(Args&&... args) {
		T tmp(static_cast<Args&&>(args)...);
		iterator it = iterator(__new_node(static_cast<T&&>(tmp), m_head.m_next));
		return *it;
	}

	void push_back(const T& v)  { __new_node(v, &m_head); }
	void push_back(T&& v)       { __new_node(static_cast<T&&>(v), &m_head); }
	void push_front(const T& v) { __new_node(v, m_head.m_next); }
	void push_front(T&& v)      { __new_node(static_cast<T&&>(v), m_head.m_next); }

	void pop_back()  { __erase_node(m_head.m_prev); }
	void pop_front() { __erase_node(m_head.m_next); }

	iterator erase(iterator pos) {
		__list_node_base* n = pos.__node();
		++pos;
		__erase_node(n);
		return pos;
	}
	iterator erase(iterator first, iterator last) {
		while (first != last) {
			__list_node_base* n = first.__node();
			++first;
			__erase_node(n);
		}
		return last;
	}

	void resize(size_type n) {
		while (m_size > n) pop_back();
		while (m_size < n) push_back(T());
	}
	void resize(size_type n, const T& v) {
		while (m_size > n) pop_back();
		while (m_size < n) push_back(v);
	}

	void swap(list& o) {
		__swap_head(o);
		size_type t = m_size; m_size = o.m_size; o.m_size = t;
	}

	/* ---- list operations -------------------------------------------- */

	/* splice moves nodes between lists without copying or allocating. */
	void splice(iterator pos, list& o) {
		if (o.m_size == 0 || &o == this) return;
		__hook(pos.__node(), o.m_head.m_next, &o.m_head);
		m_size += o.m_size;
		o.__clear_nodes_only();
		o.m_size = 0;
	}
	void splice(iterator pos, list& o, iterator it) {
		if (&o == this && pos == it) return;
		__list_node_base* n = it.__node();
		__unlink(n);
		__link(pos.__node(), n);
		if (&o != this) { ++m_size; --o.m_size; }
	}
	void splice(iterator pos, list& o, iterator first, iterator last) {
		if (first == last) return;
		if (&o == this && pos == last) return;
		size_type moved = 0;
		for (iterator it = first; it != last; ++it) ++moved;
		__list_node_base* before = pos.__node();
		__hook(before, first.__node(), last.__node());
		if (&o != this) { m_size += moved; o.m_size -= moved; }
	}

	/* merge: both lists must be sorted; ties keep the left list's elements. */
	void merge(list& o) {
		typedef T V;
		merge(o, less<V>());
	}
	template<class Cmp>
	void merge(list& o, Cmp cmp) {
		if (&o == this) return;
		iterator a = begin();
		iterator b = o.begin();
		while (a != end() && b != o.end()) {
			if (cmp(*b, *a)) {
				iterator nb = b;
				++nb;
				splice(a, o, b);
				b = nb;
			} else ++a;
		}
		if (b != o.end()) splice(end(), o);
	}

	template<class T2>
	void remove(const T2& v) {
		iterator it = begin();
		while (it != end()) {
			if (*it == v) { iterator n = it; ++n; erase(it); it = n; }
			else ++it;
		}
	}
	template<class Pred>
	void remove_if(Pred p) {
		iterator it = begin();
		while (it != end()) {
			if (p(*it)) { iterator n = it; ++n; erase(it); it = n; }
			else ++it;
		}
	}

	void unique() {
		if (m_size < 2) return;
		iterator a = begin();
		iterator b = a;
		++b;
		while (b != end()) {
			if (*a == *b) { iterator n = b; ++n; erase(b); b = n; }
			else { a = b; ++b; }
		}
	}
	template<class Cmp>
	void unique(Cmp cmp) {
		if (m_size < 2) return;
		iterator a = begin();
		iterator b = a;
		++b;
		while (b != end()) {
			if (!cmp(*a, *b)) { iterator n = b; ++n; erase(b); b = n; }
			else { a = b; ++b; }
		}
	}

	void reverse() {
		if (m_size < 2) return;
		__list_node_base* p = &m_head;
		do {
			__list_node_base* nx = p->m_next;
			p->m_next = p->m_prev;
			p->m_prev = nx;
			p = nx;
		} while (p != &m_head);
	}

	/* sort: bottom-up merge over the nodes, which is what the standard's
	   O(n log n) and stability requirements both need.  Nodes are relinked,
	   never copied.  24 buckets supports 2^24 elements, about sixteen million,
       which is several orders of magnitude past what fits in a calculator. */
	void sort() { sort(less<T>()); }

	template<class Cmp>
	void sort(Cmp cmp) {
		if (m_size < 2) return;
		list carry;
		list bucket[24];
		size_t fill = 0;
		while (!empty()) {
			carry.splice(carry.begin(), *this, begin());
			size_t i = 0;
			while (i < fill && !bucket[i].empty()) {
				bucket[i].merge(carry, cmp);
				bucket[i].swap(carry);
				++i;
			}
			carry.swap(bucket[i]);
			if (i == fill) ++fill;
		}
		for (size_t i = 1; i < fill; i++) bucket[i].merge(bucket[i - 1], cmp);
		splice(end(), bucket[fill - 1]);
	}

private:
	__list_node_base m_head;
	size_type        m_size;

	/* The sentinel in a const list is const, but the links between nodes are
	   not part of the list's logical value - only the elements are - so the
	   const overloads cast the sentinel back.  const_iterator still hands out
	   const T&, which is where the real constness lives. */
	__list_node_base* __head() const { return const_cast<__list_node_base*>(&m_head); }

	/* Link node n in before `before`. */
	static void __link(__list_node_base* before, __list_node_base* n) {
		n->m_prev = before->m_prev;
		n->m_next = before;
		before->m_prev->m_next = n;
		before->m_prev = n;
	}
	static void __unlink(__list_node_base* n) {
		n->m_prev->m_next = n->m_next;
		n->m_next->m_prev = n->m_prev;
	}
	/* Splice the whole range [f, l) in before `before`. */
	static void __hook(__list_node_base* before, __list_node_base* f, __list_node_base* l) {
		__list_node_base* fp = f->m_prev;
		__list_node_base* lp = l->m_prev;
		fp->m_next = l;
		l->m_prev = fp;
		lp->m_next = before;
		before->m_prev->m_next = f;
		f->m_prev = before->m_prev;
		before->m_prev = lp;
	}

	template<class U>
	__list_node_base* __new_node(U&& u, __list_node_base* before) {
		__list_node<T>* n = (__list_node<T>*)__stl_alloc_bytes(sizeof(__list_node<T>));
		if (!n) { __stl_fail("std::list: out of memory"); return 0; }
		__stl_construct(&n->m_v, static_cast<U&&>(u));
		__link(before, n);
		++m_size;
		return n;
	}

	void __erase_node(__list_node_base* n) {
		if (n == &m_head) return;
		__unlink(n);
		__stl_destroy(&static_cast<__list_node<T>*>(n)->m_v);
		__stl_free_bytes(n);
		--m_size;
	}

	void __clear_nodes() {
		__list_node_base* p = m_head.m_next;
		while (p != &m_head) {
			__list_node_base* n = p->m_next;
			__stl_destroy(&static_cast<__list_node<T>*>(p)->m_v);
			__stl_free_bytes(p);
			p = n;
		}
		m_head.m_prev = &m_head;
		m_head.m_next = &m_head;
	}
	/* Reset the sentinel without touching any nodes; splice leaves the source
	   list already self linked, so this is the same as __clear_nodes() would
	   be, minus the walk. */
	void __clear_nodes_only() { m_head.m_prev = &m_head; m_head.m_next = &m_head; }

	void __swap_head(list& o) {
		/* Swap the sentinels, then fix the four links that point at them.
		   An empty list's sentinel points at itself, which the branch below
		   turns into a self loop on the other side. */
		__list_node_base* an = m_head.m_next;
		__list_node_base* ap = m_head.m_prev;
		__list_node_base* bn = o.m_head.m_next;
		__list_node_base* bp = o.m_head.m_prev;
		m_head.m_next = (bn == &o.m_head) ? &m_head : bn;
		m_head.m_prev = (bp == &o.m_head) ? &m_head : bp;
		o.m_head.m_next = (an == &m_head) ? &o.m_head : an;
		o.m_head.m_prev = (ap == &m_head) ? &o.m_head : ap;
		m_head.m_next->m_prev = &m_head;
		m_head.m_prev->m_next = &m_head;
		o.m_head.m_next->m_prev = &o.m_head;
		o.m_head.m_prev->m_next = &o.m_head;
	}

	void __fill(size_type n, const T& v) {
		for (size_type i = 0; i < n; i++) push_back(v);
	}
};

/* ---- comparisons ------------------------------------------------------ */

template<class T, class A>
inline bool operator==(const list<T, A>& a, const list<T, A>& b) {
	typename list<T, A>::const_iterator ia = a.begin(), ib = b.begin();
	while (ia != a.end() && ib != b.end()) {
		if (!(*ia == *ib)) return false;
		++ia; ++ib;
	}
	return ia == a.end() && ib == b.end();
}
template<class T, class A>
inline bool operator!=(const list<T, A>& a, const list<T, A>& b) { return !(a == b); }
template<class T, class A>
inline bool operator<(const list<T, A>& a, const list<T, A>& b) {
	typename list<T, A>::const_iterator ia = a.begin(), ib = b.begin();
	while (ib != b.end()) {
		if (ia == a.end()) return true;
		if (*ia < *ib) return true;
		if (*ib < *ia) return false;
		++ia; ++ib;
	}
	return ia == a.end();
}
template<class T, class A>
inline bool operator>(const list<T, A>& a, const list<T, A>& b) { return b < a; }
template<class T, class A>
inline bool operator<=(const list<T, A>& a, const list<T, A>& b) { return !(b < a); }
template<class T, class A>
inline bool operator>=(const list<T, A>& a, const list<T, A>& b) { return !(a < b); }

template<class T, class A>
inline void swap(list<T, A>& a, list<T, A>& b) { a.swap(b); }

}  /* namespace std */

#endif
