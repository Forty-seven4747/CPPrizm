#ifndef PRIZM_CPPSHIM_CHARCONV
#define PRIZM_CPPSHIM_CHARCONV

/* <charconv>.  Full integer support in every base; double gets a basic
   general-format converter built from plain integer arithmetic so no
   floating point library is needed.  Unlike the standard version the
   double conversion is not shortest-round-trip: it prints up to 9
   significant fractional digits, or scientific notation outside the
   fixed range. */

#include <cstdint>
#include <system_error>
#include <type_traits>

namespace std {

struct to_chars_result {
	char* ptr;
	errc  ec;
};

struct from_chars_result {
	const char* ptr;
	errc        ec;
};

/* ---- integers to characters ----------------------------------------- */

namespace __ccv {

inline char __digit(unsigned v) {
	return "0123456789abcdefghijklmnopqrstuvwxyz"[v];
}

/* writes digits right-to-left into last, returns first written */
template<class T>
inline char* __itoa_rev(T v, char* last, unsigned base) {
	char* p = last;
	bool neg = false;
	if (v < 0) { neg = true; v = T() - v; }
	typename make_unsigned<T>::type u = (typename make_unsigned<T>::type)v;
	do {
		*--p = __digit((unsigned)(u % base));
		u /= base;
	} while (u);
	if (neg) *--p = '-';
	return p;
}

template<class T>
inline to_chars_result __to_chars(char* first, char* last, T value, int base) {
	if (base < 2 || base > 36) {
		return to_chars_result { last, errc::invalid_argument };
	}
	int room = (int)(last - first);
	int need = 1;
	if (value < 0) need++;
	typename make_unsigned<T>::type u =
	    (typename make_unsigned<T>::type)(value < 0 ? T() - value : value);
	while (u >= (typename make_unsigned<T>::type)base) {
		u /= base;
		need++;
	}
	if (need > room) {
		return to_chars_result { last, errc::value_too_large };
	}
	char* p = __itoa_rev(value, last, (unsigned)base);
	return to_chars_result { p, errc() };
}

}  /* namespace __ccv */

inline to_chars_result to_chars(char* first, char* last, bool value) {
	if (first == last) return to_chars_result { last, errc::value_too_large };
	*first = value ? '1' : '0';
	return to_chars_result { first + 1, errc() };
}

inline to_chars_result to_chars(char* first, char* last, char value) {
	return __ccv::__to_chars(first, last, (signed char)value, 10);
}
inline to_chars_result to_chars(char* first, char* last, signed char value) {
	return __ccv::__to_chars(first, last, value, 10);
