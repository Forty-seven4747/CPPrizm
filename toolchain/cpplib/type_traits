#ifndef PRIZM_CPPSHIM_TYPE_TRAITS
#define PRIZM_CPPSHIM_TYPE_TRAITS

/* <type_traits>.
 *
 * Two sorts of trait live here.
 *
 * The class level ones - is_class, is_pod, is_empty, is_base_of and friends -
 * forward straight to a GCC builtin, which is both correct and free.
 *
 * The fundamental ones - is_integral, is_floating_point, is_pointer and the
 * rest - have to be written out, because GCC does not expose a builtin for
 * them.  libstdc++ writes them out for exactly the same reason.  Every one of
 * them strips cv-qualifiers first, so is_integral<const int> is true the way
 * the standard says it should be.
 *
 * remove_reference, remove_const, remove_pointer and enable_if live in
 * __stl_bits because the containers need them before any user header is
 * included; they are not repeated here.
 */
#include <__stl_bits>

namespace std {

/* =====================================================================
   integral_constant
   ===================================================================== */

template<class T, T v>
struct integral_constant {
	static const T value = v;
	typedef T value_type;
	typedef integral_constant<T, v> type;
	operator T() const { return v; }
};

typedef integral_constant<bool, true>  true_type;
typedef integral_constant<bool, false> false_type;

template<bool B> struct bool_constant : integral_constant<bool, B> {};

/* =====================================================================
   cv and reference surgery

   Everything below wants the unqualified type, so these come first.
   ===================================================================== */

template<class T> struct remove_volatile            { typedef T type; };
template<class T> struct remove_volatile<volatile T> { typedef T type; };

template<class T> struct remove_cv {
	typedef typename remove_const<typename remove_volatile<T>::type>::type type;
};

template<class T> struct add_const    { typedef const T type; };
template<class T> struct add_volatile { typedef volatile T type; };
template<class T> struct add_cv       { typedef const volatile T type; };

template<class T> struct add_pointer {
	typedef typename remove_reference<T>::type* type;
};

/* A reference to void cannot be formed, and the standard says the trait then
   yields the type unchanged.  Specialising here is what lets shared_ptr<void>
   and unique_ptr<void> be declared at all. */
template<> struct add_pointer<void>                 { typedef void type; };
template<> struct add_pointer<const void>           { typedef const void type; };
template<> struct add_pointer<volatile void>        { typedef volatile void type; };
template<> struct add_pointer<const volatile void>  { typedef const volatile void type; };

template<class T> struct add_lvalue_reference {
	typedef typename remove_reference<T>::type& type;
};
template<class T> struct add_rvalue_reference {
	typedef typename remove_reference<T>::type&& type;
};

template<> struct add_lvalue_reference<void>                { typedef void type; };
template<> struct add_lvalue_reference<const void>          { typedef const void type; };
template<> struct add_lvalue_reference<volatile void>       { typedef volatile void type; };
template<> struct add_lvalue_reference<const volatile void> { typedef const volatile void type; };
template<> struct add_rvalue_reference<void>                { typedef void type; };
template<> struct add_rvalue_reference<const void>          { typedef const void type; };
template<> struct add_rvalue_reference<volatile void>       { typedef volatile void type; };
template<> struct add_rvalue_reference<const volatile void> { typedef const volatile void type; };

template<class T> struct remove_extent              { typedef T type; };
template<class T> struct remove_extent<T[]>         { typedef T type; };
template<class T, size_t N> struct remove_extent<T[N]> { typedef T type; };

template<class T> struct remove_all_extents         { typedef T type; };
template<class T> struct remove_all_extents<T[]>    { typedef typename remove_all_extents<T>::type type; };
template<class T, size_t N> struct remove_all_extents<T[N]> { typedef typename remove_all_extents<T>::type type; };

template<bool B, class T, class F> struct conditional        { typedef T type; };
template<class T, class F> struct conditional<false, T, F>   { typedef F type; };

/* Handy inside the traits below: the cv-stripped type. */
template<class T> struct __stl_unqual {
	typedef typename remove_cv<T>::type type;
};

/* =====================================================================
   void, integral, floating point
   ===================================================================== */

template<class T, class U = typename __stl_unqual<T>::type>
struct __stl_is_void_raw : false_type {};
template<class T>
struct __stl_is_void_raw<T, void> : true_type {};
template<class T> struct is_void : __stl_is_void_raw<T> {};

template<class T> struct __stl_is_integral_raw            : false_type {};
template<> struct __stl_is_integral_raw<bool>             : true_type {};
template<> struct __stl_is_integral_raw<char>             : true_type {};
template<> struct __stl_is_integral_raw<signed char>      : true_type {};
template<> struct __stl_is_integral_raw<unsigned char>    : true_type {};
template<> struct __stl_is_integral_raw<short>            : true_type {};
template<> struct __stl_is_integral_raw<unsigned short>   : true_type {};
template<> struct __stl_is_integral_raw<int>              : true_type {};
template<> struct __stl_is_integral_raw<unsigned int>     : true_type {};
template<> struct __stl_is_integral_raw<long>             : true_type {};
template<> struct __stl_is_integral_raw<unsigned long>    : true_type {};
template<> struct __stl_is_integral_raw<long long>        : true_type {};
template<> struct __stl_is_integral_raw<unsigned long long> : true_type {};
template<class T> struct is_integral :
	__stl_is_integral_raw<typename __stl_unqual<T>::type> {};

template<class T> struct __stl_is_fp_raw          : false_type {};
template<> struct __stl_is_fp_raw<float>          : true_type {};
template<> struct __stl_is_fp_raw<double>         : true_type {};
template<> struct __stl_is_fp_raw<long double>    : true_type {};
template<class T> struct is_floating_point :
	__stl_is_fp_raw<typename __stl_unqual<T>::type> {};

template<class T> struct is_arithmetic :
	integral_constant<bool, is_integral<T>::value ||
	                        is_floating_point<T>::value> {};

template<class T> struct is_fundamental :
	integral_constant<bool, is_arithmetic<T>::value ||
	                        is_void<T>::value> {};

/* =====================================================================
   signedness
   ===================================================================== */

template<class T> struct __stl_is_signed_raw          : false_type {};
template<> struct __stl_is_signed_raw<char>           : integral_constant<bool, ((char)-1 < 0)> {};
template<> struct __stl_is_signed_raw<signed char>    : true_type {};
template<> struct __stl_is_signed_raw<short>          : true_type {};
template<> struct __stl_is_signed_raw<int>            : true_type {};
template<> struct __stl_is_signed_raw<long>           : true_type {};
template<> struct __stl_is_signed_raw<long long>      : true_type {};
template<> struct __stl_is_signed_raw<float>          : true_type {};
template<> struct __stl_is_signed_raw<double>         : true_type {};
template<> struct __stl_is_signed_raw<long double>    : true_type {};
template<class T> struct is_signed :
	__stl_is_signed_raw<typename __stl_unqual<T>::type> {};

template<class T> struct __stl_is_unsigned_raw        : false_type {};
template<> struct __stl_is_unsigned_raw<bool>         : true_type {};
template<> struct __stl_is_unsigned_raw<char>         : integral_constant<bool, ((char)-1 > 0)> {};
template<> struct __stl_is_unsigned_raw<unsigned char>: true_type {};
template<> struct __stl_is_unsigned_raw<unsigned short>: true_type {};
template<> struct __stl_is_unsigned_raw<unsigned int> : true_type {};
template<> struct __stl_is_unsigned_raw<unsigned long>: true_type {};
template<> struct __stl_is_unsigned_raw<unsigned long long> : true_type {};
template<class T> struct is_unsigned :
	__stl_is_unsigned_raw<typename __stl_unqual<T>::type> {};

/* =====================================================================
   pointer, reference, array, function
   ===================================================================== */

template<class T> struct __stl_is_pointer_raw        : false_type {};
template<class T> struct __stl_is_pointer_raw<T*>    : true_type {};
template<class T> struct is_pointer :
	__stl_is_pointer_raw<typename __stl_unqual<T>::type> {};

template<class T> struct is_reference        : false_type {};
template<class T> struct is_reference<T&>    : true_type {};
template<class T> struct is_reference<T&&>   : true_type {};

template<class T> struct is_lvalue_reference      : false_type {};
template<class T> struct is_lvalue_reference<T&>  : true_type {};

template<class T> struct is_rvalue_reference      : false_type {};
template<class T> struct is_rvalue_reference<T&&> : true_type {};

template<class T> struct is_array          : false_type {};
template<class T> struct is_array<T[]>     : true_type {};
template<class T, size_t N> struct is_array<T[N]> : true_type {};

template<class T> struct is_function             : false_type {};
template<class R, class... A> struct is_function<R(A...)>       : true_type {};
template<class R, class... A> struct is_function<R(A...) const> : true_type {};
template<class R, class... A> struct is_function<R(A...) volatile> : true_type {};
template<class R, class... A> struct is_function<R(A...) const volatile> : true_type {};

template<class T, class U> struct is_same          : false_type {};
template<class T> struct is_same<T, T>             : true_type {};

template<class T> struct is_const            : false_type {};
template<class T> struct is_const<const T>   : true_type {};

template<class T> struct is_volatile            : false_type {};
template<class T> struct is_volatile<volatile T> : true_type {};

/* =====================================================================
   class level traits, straight from the compiler
   ===================================================================== */

template<class T> struct is_class      : integral_constant<bool, __is_class(T)> {};
template<class T> struct is_union      : integral_constant<bool, __is_union(T)> {};
template<class T> struct is_enum       : integral_constant<bool, __is_enum(T)> {};
template<class T> struct is_pod        : integral_constant<bool, __is_pod(T)> {};
template<class T> struct is_empty      : integral_constant<bool, __is_empty(T)> {};
template<class T> struct is_abstract   : integral_constant<bool, __is_abstract(T)> {};
template<class T> struct is_polymorphic: integral_constant<bool, __is_polymorphic(T)> {};
template<class T> struct is_trivial    : integral_constant<bool, __is_trivial(T)> {};
template<class T> struct is_standard_layout : integral_constant<bool, __is_standard_layout(T)> {};
template<class T> struct is_literal_type    : integral_constant<bool, __is_literal_type(T)> {};
template<class T> struct is_final           : integral_constant<bool, __is_final(T)> {};
template<class T> struct is_aggregate       : integral_constant<bool, __is_aggregate(T)> {};

template<class T> struct is_trivially_copyable
	: integral_constant<bool, __is_trivially_copyable(T)> {};
template<class T> struct is_trivially_destructible
	: integral_constant<bool, __has_trivial_destructor(T)> {};
template<class T> struct has_trivial_destructor
	: integral_constant<bool, __has_trivial_destructor(T)> {};
template<class T> struct has_trivial_copy
	: integral_constant<bool, __has_trivial_copy(T)> {};
template<class T> struct has_trivial_assign
	: integral_constant<bool, __has_trivial_assign(T)> {};
template<class T> struct has_nothrow_copy
	: integral_constant<bool, __has_nothrow_copy(T)> {};
template<class T> struct has_nothrow_assign
	: integral_constant<bool, __has_nothrow_assign(T)> {};
template<class T> struct has_nothrow_constructor
	: integral_constant<bool, __has_nothrow_constructor(T)> {};
template<class T> struct has_virtual_destructor
	: integral_constant<bool, __has_virtual_destructor(T)> {};

template<class T> struct is_nothrow_copy_constructible
	: has_nothrow_copy<T> {};
template<class T> struct is_nothrow_move_constructible
	: has_nothrow_copy<T> {};
template<class T> struct is_copy_constructible
	: integral_constant<bool, !is_void<T>::value && !is_function<T>::value> {};
template<class T> struct is_move_constructible : is_copy_constructible<T> {};

/* =====================================================================
   relationships
   ===================================================================== */

template<class Base, class Derived>
struct is_base_of : integral_constant<bool, __is_base_of(Base, Derived)> {};

/* is_convertible has no builtin on this compiler, so it is the classic SFINAE
   test: the compiler is asked to pass a From to a function taking a To, and if
   overload resolution succeeds the conversion exists.

   Two details matter and both are easy to get wrong:
     - the failing expression has to sit in a template parameter, not in a
       default function argument, because default arguments are not substituted
       during overload resolution;
     - the two candidates must return types of different size.  Returning
       true_type and false_type looks natural and is wrong: both are empty
       classes, both are 1 byte, and the comparison is then always equal, so
       every pair of types comes out convertible. */
template<class From, class To>
struct is_convertible {
private:
	static void __stl_conv_sink(To);

	template<class F, class = decltype(__stl_conv_sink(__stl_declval<F>()))>
	static char __stl_conv_test(int);
	template<class>
	static long long __stl_conv_test(...);
public:
	static const bool value = sizeof(__stl_conv_test<From>(0)) == sizeof(char);
};

template<class T, class... Args>
struct is_constructible : integral_constant<bool, __is_constructible(T, Args...)> {};

/* =====================================================================
   decay, make_signed, make_unsigned, underlying_type
   ===================================================================== */

template<class T> struct decay {
private:
	typedef typename remove_reference<T>::type U;
public:
	typedef typename conditional<
		is_array<U>::value,
		typename remove_extent<U>::type*,
		typename conditional<is_function<U>::value,
			typename add_pointer<U>::type,
			typename remove_cv<U>::type>::type
	>::type type;
};

template<class T> struct make_signed   { typedef T type; };
template<class T> struct make_unsigned { typedef T type; };

template<> struct make_signed<char>               { typedef signed char type; };
template<> struct make_signed<signed char>        { typedef signed char type; };
template<> struct make_signed<unsigned char>      { typedef signed char type; };
template<> struct make_signed<short>              { typedef short type; };
template<> struct make_signed<unsigned short>     { typedef short type; };
template<> struct make_signed<int>                { typedef int type; };
template<> struct make_signed<unsigned int>       { typedef int type; };
template<> struct make_signed<long>               { typedef long type; };
template<> struct make_signed<unsigned long>      { typedef long type; };
template<> struct make_signed<long long>          { typedef long long type; };
template<> struct make_signed<unsigned long long> { typedef long long type; };

template<> struct make_unsigned<char>               { typedef unsigned char type; };
template<> struct make_unsigned<signed char>        { typedef unsigned char type; };
template<> struct make_unsigned<unsigned char>      { typedef unsigned char type; };
template<> struct make_unsigned<short>              { typedef unsigned short type; };
template<> struct make_unsigned<unsigned short>     { typedef unsigned short type; };
template<> struct make_unsigned<int>                { typedef unsigned int type; };
template<> struct make_unsigned<unsigned int>       { typedef unsigned int type; };
template<> struct make_unsigned<long>               { typedef unsigned long type; };
template<> struct make_unsigned<unsigned long>      { typedef unsigned long type; };
template<> struct make_unsigned<long long>          { typedef unsigned long long type; };
template<> struct make_unsigned<unsigned long long> { typedef unsigned long long type; };

template<class T> struct underlying_type {
	typedef __underlying_type(T) type;
};

/* =====================================================================
   aligned storage and rank
   ===================================================================== */

template<size_t N, size_t Align>
struct aligned_storage {
	struct alignas(Align) type { unsigned char m_data[N ? N : 1]; };
};

template<size_t N>
struct aligned_storage_default {
	struct type { alignas(8) unsigned char m_data[N ? N : 1]; };
};

template<class T> struct rank { static const size_t value = 0; };
template<class T> struct rank<T[]> { static const size_t value = 1 + rank<T>::value; };
template<class T, size_t N> struct rank<T[N]> { static const size_t value = 1 + rank<T>::value; };

template<class T> struct extent { static const size_t value = 0; };
template<class T> struct extent<T[]> { static const size_t value = 0; };
template<class T, size_t N> struct extent<T[N]> { static const size_t value = N; };

/* =====================================================================
   common_type, used by <algorithm>'s min/max pairs and by numeric code
   ===================================================================== */

template<class T> struct __stl_common_decay { typedef typename decay<T>::type type; };

template<class A, class B, class C = void>
struct common_type_2 {
	typedef typename conditional<
		(is_arithmetic<A>::value && is_arithmetic<B>::value),
		typename conditional<sizeof(A) >= sizeof(B), A, B>::type,
		A>::type type;
};

template<class A, class B>
struct common_type : common_type_2<A, B> {};

/* =====================================================================
   The C++14 _t / _v spellings.

   Console code written against a modern standard library names these, and
   they are also what makes pack expansion work: `tuple<decay<Ts>::type...>`
   is rejected by this compiler, while `tuple<__decay_t<Ts>...>` is not.
   ===================================================================== */

template<class T> using remove_const_t    = typename remove_const<T>::type;
template<class T> using remove_volatile_t = typename remove_volatile<T>::type;
template<class T> using remove_cv_t       = typename remove_cv<T>::type;
template<class T> using remove_reference_t = typename remove_reference<T>::type;
template<class T> using remove_pointer_t  = typename remove_pointer<T>::type;
template<class T> using remove_extent_t   = typename remove_extent<T>::type;
template<class T> using remove_all_extents_t = typename remove_all_extents<T>::type;
template<class T> using add_const_t       = typename add_const<T>::type;
template<class T> using add_volatile_t    = typename add_volatile<T>::type;
template<class T> using add_cv_t          = typename add_cv<T>::type;
template<class T> using add_pointer_t     = typename add_pointer<T>::type;
template<class T> using add_lvalue_reference_t = typename add_lvalue_reference<T>::type;
template<class T> using add_rvalue_reference_t = typename add_rvalue_reference<T>::type;
template<class T> using make_signed_t     = typename make_signed<T>::type;
template<class T> using make_unsigned_t   = typename make_unsigned<T>::type;
template<class T> using decay_t           = typename decay<T>::type;
template<class T> using underlying_type_t = typename underlying_type<T>::type;
template<bool B, class T = void> using enable_if_t = typename enable_if<B, T>::type;
template<bool B, class T, class F> using conditional_t = typename conditional<B, T, F>::type;
template<class A, class B> using common_type_t = typename common_type<A, B>::type;
template<size_t I, class T> using tuple_element_t = typename tuple_element<I, T>::type;

/* result_of / invoke_result: what F(A...) yields when called.  Deprecated in
   C++17 and removed in C++20, but old console code still names it. */
template<class F, class... A>
struct __stl_result_of {
	typedef decltype(__stl_declval<F>()(__stl_declval<A>()...)) type;
};

template<class Sig> struct result_of;
template<class F, class... A>
struct result_of<F(A...)> : __stl_result_of<F, A...> {};

template<class F, class... A>
struct invoke_result : __stl_result_of<F, A...> {};

template<class Sig> using result_of_t = typename result_of<Sig>::type;
template<class F, class... A> using invoke_result_t = typename invoke_result<F, A...>::type;

/* Internal short spelling, so the headers do not have to repeat `typename`. */
template<class T> using __decay_t     = typename decay<T>::type;
template<class T> using __unqual_t    = typename remove_cv<T>::type;
template<class T> using __remref_t    = typename remove_reference<T>::type;

template<class T> constexpr bool is_void_v            = is_void<T>::value;
template<class T> constexpr bool is_integral_v        = is_integral<T>::value;
template<class T> constexpr bool is_floating_point_v  = is_floating_point<T>::value;
template<class T> constexpr bool is_arithmetic_v      = is_arithmetic<T>::value;
template<class T> constexpr bool is_fundamental_v     = is_fundamental<T>::value;
template<class T> constexpr bool is_signed_v          = is_signed<T>::value;
template<class T> constexpr bool is_unsigned_v        = is_unsigned<T>::value;
template<class T> constexpr bool is_pointer_v         = is_pointer<T>::value;
template<class T> constexpr bool is_reference_v       = is_reference<T>::value;
template<class T> constexpr bool is_array_v           = is_array<T>::value;
template<class T> constexpr bool is_function_v        = is_function<T>::value;
template<class T> constexpr bool is_class_v           = is_class<T>::value;
template<class T> constexpr bool is_enum_v            = is_enum<T>::value;
template<class T> constexpr bool is_pod_v             = is_pod<T>::value;
template<class T> constexpr bool is_empty_v           = is_empty<T>::value;
template<class T> constexpr bool is_abstract_v        = is_abstract<T>::value;
template<class T> constexpr bool is_polymorphic_v     = is_polymorphic<T>::value;
template<class T> constexpr bool is_const_v           = is_const<T>::value;
template<class T> constexpr bool is_volatile_v        = is_volatile<T>::value;
template<class A, class B> constexpr bool is_same_v   = is_same<A, B>::value;
template<class B, class D> constexpr bool is_base_of_v = is_base_of<B, D>::value;
template<class F, class T> constexpr bool is_convertible_v = is_convertible<F, T>::value;
template<class T, class... A> constexpr bool is_constructible_v = is_constructible<T, A...>::value;

}  /* namespace std */

#endif
