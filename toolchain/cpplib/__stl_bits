#ifndef PRIZM_STL_BITS
#define PRIZM_STL_BITS

/* ---------------------------------------------------------------------------
   Shared machinery for the hand written standard library.

   The Prizm has no libstdc++, so every standard header in this directory is
   written from scratch.  They all need the same handful of things - move and
   forward, pair, swap, the comparator functors, iterator categories, an
   allocator - so those live here and the individual headers (utility,
   type_traits, iterator, limits, functional, memory) simply pull this in and
   add what is specific to them.

   Rules this whole library follows:

     - No exceptions.  The build uses -fno-exceptions, so throw is not even
       available.  Where the standard would throw, these headers call
       prizm_stl_fatal() instead, which prints the reason on the console and
       waits for a key.  Allocation failure is the one exception: a container
       that cannot grow simply stays as it was, the same way the string shim
       already behaved.
     - No RTTI, no typeid, no dynamic_cast.
     - No <cstdlib> / <cmath> / <ctime> includes, on purpose.  Those three
       shadow the host's own headers when this directory is on a PC include
       path, which breaks the compiler's own standard library, so the headers
       that must stay host compilable reach for the plain C headers
       (<stdlib.h>, <string.h>) instead.
   --------------------------------------------------------------------------- */

#include <stddef.h>
#include <stdlib.h>
#include <string.h>

/* =====================================================================
   placement new

   Belongs in <new> per the standard, but every container needs it and <new>
   includes this file, so it is defined here once, at global scope as the
   standard requires.
   ===================================================================== */

inline void* operator new(size_t, void* p) { return p; }
inline void* operator new[](size_t, void* p) { return p; }
inline void operator delete(void*, void*) {}
inline void operator delete[](void*, void*) {}

namespace std {

/* size_t is in the SDK's stddef.h, but ptrdiff_t is not - that header is a
   minimal freestanding one.  The compiler knows the right type for the target
   and offers it as __PTRDIFF_TYPE__, which is also how libstdc++ gets it, so
   no header has to be involved and nothing here can be shadowed. */
typedef __PTRDIFF_TYPE__ ptrdiff_t;
using ::size_t;

typedef size_t          size_type;
typedef ptrdiff_t       difference_type;

/* =====================================================================
   failure hook

   Declared weak so the headers stay usable without the runtime: if nothing
   defines it the check simply does nothing.  prizm_rt.cpp normally does.
   ===================================================================== */

extern "C" void prizm_stl_fatal(const char* what) __attribute__((weak));

inline void __stl_fail(const char* what) {
	if (prizm_stl_fatal) prizm_stl_fatal(what);
}

/* =====================================================================
   raw memory

   malloc / realloc / free are in libc, which libfxcg backs with the system
   heap.  operator new would be the C++ way to reach it, but a container wants
   to report failure rather than to be handed a null pointer, so the helpers
   below go straight to malloc and let the caller decide.
   ===================================================================== */

inline void* __stl_alloc_bytes(size_t n) {
	if (n == 0) n = 1;
	return malloc(n);
}

inline void* __stl_realloc_bytes(void* p, size_t n) {
	if (n == 0) n = 1;
	return realloc(p, n);
}

inline void __stl_free_bytes(void* p) { if (p) free(p); }

/* =====================================================================
   type traits kernel

   Only what the library itself needs; type_traits adds the public spelling.
   ===================================================================== */

template<class T> struct remove_reference      { typedef T type; };
template<class T> struct remove_reference<T&>  { typedef T type; };
template<class T> struct remove_reference<T&&> { typedef T type; };

template<class T> struct remove_const          { typedef T type; };
template<class T> struct remove_const<const T> { typedef T type; };

template<class T> struct remove_pointer                    { typedef T type; };
template<class T> struct remove_pointer<T*>                { typedef T type; };
template<class T> struct remove_pointer<T* const>          { typedef T type; };

template<bool B, class T = void> struct enable_if {};
template<class T> struct enable_if<true, T> { typedef T type; };

template<class T> struct __stl_is_pod { static const bool value = __is_trivially_copyable(T); };
template<class T> struct __stl_is_enum { static const bool value = __is_enum(T); };

/* Trivially copyable means the bytes can be moved with memmove and a buffer
   can grow by reallocating.  Everything else has to be moved element by
   element so that a non-trivial copy constructor still runs. */
template<class T> struct __stl_trivial {
	static const bool value = __is_trivially_copyable(T);
};

/* =====================================================================
   move, forward, swap
   ===================================================================== */

template<class T>
inline typename remove_reference<T>::type&& move(T&& t) {
	return static_cast<typename remove_reference<T>::type&&>(t);
}

template<class T>
inline T&& forward(typename remove_reference<T>::type& t) {
	return static_cast<T&&>(t);
}

template<class T>
inline T&& forward(typename remove_reference<T>::type&& t) {
	return static_cast<T&&>(t);
}

template<class T> inline void swap(T& a, T& b) {
	T t = static_cast<T&&>(a);
	a = static_cast<T&&>(b);
	b = static_cast<T&&>(t);
}

template<class T, size_t N> inline void swap(T (&a)[N], T (&b)[N]) {
	for (size_t i = 0; i < N; i++) swap(a[i], b[i]);
}

template<class T> inline void swap(T*& a, T*& b) {
	T* t = a; a = b; b = t;
}

template<class T> inline T* addressof(T& r) { return &r; }

template<class T> inline T&& __stl_declval() { return static_cast<T&&>(*(T*)0); }

/* Public name.  <utility> also provides it; having it here means every header
   that includes __stl_bits (i.e. all of them) can use it in a trailing return
   type without pulling in <utility>. */
template<class T> inline T&& declval() { return static_cast<T&&>(*(T*)0); }

/* =====================================================================
   pair and get
   ===================================================================== */

/* Declared here, defined in tuple.  Structured bindings on a pair
   (for (auto& [k, v] : some_map)) go through these three names, so they have
   to exist even for programs that never include <tuple>. */
template<class T> struct tuple_size;
template<size_t I, class T> struct tuple_element;

template<class A, class B>
class pair {
public:
	typedef A first_type;
	typedef B second_type;

	A first;
	B second;

	pair() : first(), second() {}
	pair(const A& a, const B& b) : first(a), second(b) {}
	template<class U, class V>
	pair(const pair<U, V>& p) : first(p.first), second(p.second) {}

	template<class U, class V>
	pair& operator=(const pair<U, V>& p) {
		first = p.first;
		second = p.second;
		return *this;
	}

	void swap(pair& o) {
		using std::swap;
		swap(first, o.first);
		swap(second, o.second);
	}
};

template<class A, class B>
inline pair<A, B> make_pair(A a, B b) { return pair<A, B>(a, b); }

template<class A, class B>
inline bool operator==(const pair<A, B>& x, const pair<A, B>& y) {
	return x.first == y.first && x.second == y.second;
}
template<class A, class B>
inline bool operator!=(const pair<A, B>& x, const pair<A, B>& y) {
	return !(x == y);
}
template<class A, class B>
inline bool operator<(const pair<A, B>& x, const pair<A, B>& y) {
	return x.first < y.first || (!(y.first < x.first) && x.second < y.second);
}
template<class A, class B>
inline bool operator>(const pair<A, B>& x, const pair<A, B>& y) { return y < x; }
template<class A, class B>
inline bool operator<=(const pair<A, B>& x, const pair<A, B>& y) { return !(y < x); }
template<class A, class B>
inline bool operator>=(const pair<A, B>& x, const pair<A, B>& y) { return !(x < y); }

template<class A, class B> inline void swap(pair<A, B>& x, pair<A, B>& y) { x.swap(y); }

template<class A, class B> struct tuple_size<pair<A, B> > {
	static const size_t value = 2;
};
template<class A, class B> struct tuple_element<0, pair<A, B> > { typedef A type; };
template<class A, class B> struct tuple_element<1, pair<A, B> > { typedef B type; };

template<size_t I, class A, class B>
struct __stl_pair_get;
template<class A, class B>
struct __stl_pair_get<0, A, B> {
	static A& get(pair<A, B>& p) { return p.first; }
	static const A& get(const pair<A, B>& p) { return p.first; }
};
template<class A, class B>
struct __stl_pair_get<1, A, B> {
	static B& get(pair<A, B>& p) { return p.second; }
	static const B& get(const pair<A, B>& p) { return p.second; }
};

template<size_t I, class A, class B>
inline typename tuple_element<I, pair<A, B> >::type& get(pair<A, B>& p) {
	return __stl_pair_get<I, A, B>::get(p);
}
template<size_t I, class A, class B>
inline const typename tuple_element<I, pair<A, B> >::type& get(const pair<A, B>& p) {
	return __stl_pair_get<I, A, B>::get(p);
}

/* The rvalue overloads are not optional decoration.  A by-value structured
   binding - `auto [k, v] = p;` - is specified as get<i>(forward<E>(e)), and
   forwarding a by-value E produces an rvalue, so with only the lvalue and
   const overloads present the call lands on the const one and the binding
   fails to compile ("binding reference of type int& to const int"). */
template<size_t I, class A, class B>
inline typename tuple_element<I, pair<A, B> >::type&& get(pair<A, B>&& p) {
	return static_cast<typename tuple_element<I, pair<A, B> >::type&&>(
	    get<I>(static_cast<pair<A, B>&>(p)));
}
template<size_t I, class A, class B>
inline const typename tuple_element<I, pair<A, B> >::type&& get(const pair<A, B>&& p) {
	return static_cast<const typename tuple_element<I, pair<A, B> >::type&&>(
	    get<I>(static_cast<const pair<A, B>&>(p)));
}

