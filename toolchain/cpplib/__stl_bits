/* =====================================================================
   hash

   Only what a hash table needs.  Integral keys hash to themselves mixed a
   little, pointers and C strings get their own case, and anything else with a
   conversion to size_t falls back to that.
   ===================================================================== */

inline size_t __stl_hash_bytes(const void* p, size_t n) {
	/* FNV-1a, 32 bit.  Short and good enough for a calculator. */
	const unsigned char* s = (const unsigned char*)p;
	size_t h = 2166136261u;
	for (size_t i = 0; i < n; i++) {
		h ^= s[i];
		h *= 16777619u;
	}
	return h;
}

template<class T> struct hash {
	size_t operator()(const T& v) const {
		return __stl_hash_bytes(&v, sizeof(T));
	}
};

#define PRIZM_STL_HASH_INT(T) \
	template<> struct hash<T> { \
		size_t operator()(T v) const { return (size_t)v * 2654435761u; } \
	};
PRIZM_STL_HASH_INT(bool)
PRIZM_STL_HASH_INT(char)
PRIZM_STL_HASH_INT(signed char)
PRIZM_STL_HASH_INT(unsigned char)
PRIZM_STL_HASH_INT(short)
PRIZM_STL_HASH_INT(unsigned short)
PRIZM_STL_HASH_INT(int)
PRIZM_STL_HASH_INT(unsigned int)
PRIZM_STL_HASH_INT(long)
PRIZM_STL_HASH_INT(unsigned long)
PRIZM_STL_HASH_INT(long long)
PRIZM_STL_HASH_INT(unsigned long long)
#undef PRIZM_STL_HASH_INT

template<> struct hash<float> {
	size_t operator()(float v) const { return __stl_hash_bytes(&v, sizeof(v)); }
};
template<> struct hash<double> {
	size_t operator()(double v) const { return __stl_hash_bytes(&v, sizeof(v)); }
};
template<class T> struct hash<T*> {
	size_t operator()(T* v) const { return (size_t)v * 2654435761u; }
};
template<> struct hash<const char*> {
	size_t operator()(const char* s) const {
		return s ? __stl_hash_bytes(s, strlen(s)) : 0;
	}
};
template<> struct hash<char*> {
	size_t operator()(char* s) const { return hash<const char*>()(s); }
};

/* =====================================================================
   iterator categories and traits
   ===================================================================== */

struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : public input_iterator_tag {};
struct bidirectional_iterator_tag : public forward_iterator_tag {};
struct random_access_iterator_tag : public bidirectional_iterator_tag {};

template<class Category, class T, class Distance = ptrdiff_t,
         class Pointer = T*, class Reference = T&>
struct iterator {
	typedef Category  iterator_category;
	typedef T         value_type;
	typedef Distance  difference_type;
	typedef Pointer   pointer;
	typedef Reference reference;
};

template<class It> struct iterator_traits {
	typedef typename It::iterator_category iterator_category;
	typedef typename It::value_type        value_type;
	typedef typename It::difference_type   difference_type;
	typedef typename It::pointer           pointer;
	typedef typename It::reference         reference;
};

/* Plain pointers are iterators too, and this is the specialisation that makes
   every algorithm work on a raw array. */
template<class T> struct iterator_traits<T*> {
	typedef random_access_iterator_tag iterator_category;
	typedef T                          value_type;
	typedef ptrdiff_t                  difference_type;
	typedef T*                         pointer;
	typedef T&                         reference;
};
template<class T> struct iterator_traits<const T*> {
	typedef random_access_iterator_tag iterator_category;
	typedef T                          value_type;
	typedef ptrdiff_t                  difference_type;
	typedef const T*                   pointer;
	typedef const T&                   reference;
};

/* =====================================================================
   distance, advance, next, prev
   ===================================================================== */

template<class It> inline difference_type __stl_distance(It first, It last, random_access_iterator_tag) {
	return last - first;
}
template<class It> inline difference_type __stl_distance(It first, It last, input_iterator_tag) {
	difference_type n = 0;
	while (first != last) { ++first; ++n; }
	return n;
}
template<class It> inline difference_type distance(It first, It last) {
	return __stl_distance(first, last,
	                      typename iterator_traits<It>::iterator_category());
}

template<class It, class D> inline void __stl_advance(It& it, D n, random_access_iterator_tag) {
	it += n;
}
template<class It, class D> inline void __stl_advance(It& it, D n, bidirectional_iterator_tag) {
	if (n > 0) while (n--) ++it;
	else while (n++) --it;
}
template<class It, class D> inline void __stl_advance(It& it, D n, input_iterator_tag) {
	while (n--) ++it;
}
template<class It, class D> inline void advance(It& it, D n) {
	__stl_advance(it, n, typename iterator_traits<It>::iterator_category());
}
template<class It> inline It next(It it, difference_type n = 1) { advance(it, n); return it; }
template<class It> inline It prev(It it, difference_type n = 1) { advance(it, -n); return it; }

/* =====================================================================
   reverse_iterator

   Every container's rbegin/rend is built on this.  Its operator* relies on
   the base iterator supporting -- and *, which vector, deque, list, map and
   the hash tables all do.
   ===================================================================== */

template<class It>
class reverse_iterator {
public:
	typedef typename iterator_traits<It>::iterator_category iterator_category;
	typedef typename iterator_traits<It>::value_type        value_type;
	typedef typename iterator_traits<It>::difference_type   difference_type;
	typedef typename iterator_traits<It>::pointer           pointer;
	typedef typename iterator_traits<It>::reference         reference;
	typedef It                                              iterator_type;

	reverse_iterator() : m_base() {}
	explicit reverse_iterator(It it) : m_base(it) {}
	template<class U> reverse_iterator(const reverse_iterator<U>& o) : m_base(o.base()) {}

	It base() const { return m_base; }
	reference operator*() const { It t = m_base; --t; return *t; }
	pointer operator->() const { It t = m_base; --t; return &*t; }
	reference operator[](difference_type n) const { return *(*this + n); }

	reverse_iterator& operator++()    { --m_base; return *this; }
	reverse_iterator  operator++(int) { reverse_iterator t(*this); --m_base; return t; }
	reverse_iterator& operator--()    { ++m_base; return *this; }
	reverse_iterator  operator--(int) { reverse_iterator t(*this); ++m_base; return t; }
	reverse_iterator& operator+=(difference_type n) { m_base -= n; return *this; }
	reverse_iterator& operator-=(difference_type n) { m_base += n; return *this; }
	reverse_iterator  operator+(difference_type n) const { return reverse_iterator(m_base - n); }
	reverse_iterator  operator-(difference_type n) const { return reverse_iterator(m_base + n); }

private:
	It m_base;
};

template<class It>
inline bool operator==(const reverse_iterator<It>& a, const reverse_iterator<It>& b) {
	return a.base() == b.base();
}
template<class It>
inline bool operator!=(const reverse_iterator<It>& a, const reverse_iterator<It>& b) {
	return !(a == b);
}
template<class It>
inline bool operator<(const reverse_iterator<It>& a, const reverse_iterator<It>& b) {
	return b.base() < a.base();
}
template<class It>
inline typename reverse_iterator<It>::difference_type
operator-(const reverse_iterator<It>& a, const reverse_iterator<It>& b) {
	return b.base() - a.base();
}

/* =====================================================================
   insert iterators
   ===================================================================== */

template<class Container>
class back_insert_iterator {
public:
	typedef output_iterator_tag iterator_category;
	typedef void                value_type;
	typedef void                difference_type;
	typedef void                pointer;
	typedef void                reference;

	explicit back_insert_iterator(Container& c) : m_c(&c) {}
	back_insert_iterator& operator=(const typename Container::value_type& v) {
		m_c->push_back(v);
		return *this;
	}
	back_insert_iterator& operator*()     { return *this; }
	back_insert_iterator& operator++()    { return *this; }
	back_insert_iterator& operator++(int) { return *this; }

protected:
	Container* m_c;
};

template<class Container>
inline back_insert_iterator<Container> back_inserter(Container& c) {
	return back_insert_iterator<Container>(c);
}

template<class Container>
class front_insert_iterator {
public:
	typedef output_iterator_tag iterator_category;
	typedef void                value_type;
	typedef void                difference_type;
	typedef void                pointer;
	typedef void                reference;

	explicit front_insert_iterator(Container& c) : m_c(&c) {}
	front_insert_iterator& operator=(const typename Container::value_type& v) {
		m_c->push_front(v);
		return *this;
	}
	front_insert_iterator& operator*()     { return *this; }
	front_insert_iterator& operator++()    { return *this; }
	front_insert_iterator& operator++(int) { return *this; }

protected:
	Container* m_c;
};

template<class Container>
inline front_insert_iterator<Container> front_inserter(Container& c) {
	return front_insert_iterator<Container>(c);
}

/* =====================================================================
   char_traits

   Nothing here is a template over the character type in practice - the
   console is ASCII - but code that names std::char_traits<char> has to find
   it.
   ===================================================================== */

template<class CharT> struct char_traits {
	static size_t length(const CharT* s) { size_t n = 0; while (s[n]) n++; return n; }
	static int compare(const CharT* a, const CharT* b, size_t n) {
		for (size_t i = 0; i < n; i++) { if (a[i] != b[i]) return (int)(a[i] - b[i]); }
		return 0;
	}
	static CharT* copy(CharT* d, const CharT* s, size_t n) {
		for (size_t i = 0; i < n; i++) d[i] = s[i];
		return d;
	}
	static CharT* move(CharT* d, const CharT* s, size_t n) {
		memmove(d, s, n * sizeof(CharT));
		return d;
	}
	static CharT* assign(CharT* d, size_t n, CharT c) {
		for (size_t i = 0; i < n; i++) d[i] = c;
		return d;
	}
	static const CharT* find(const CharT* s, size_t n, CharT c) {
		for (size_t i = 0; i < n; i++) if (s[i] == c) return s + i;
		return 0;
	}
	static bool eq(CharT a, CharT b) { return a == b; }
	static bool lt(CharT a, CharT b) { return a < b; }
};

/* =====================================================================
   allocator

   The container implementation calls the __stl_* helpers directly, but
   allocator<T> has to exist because programs pass it around and because
   allocator_traits-style code names it.
   ===================================================================== */

template<class T>
class allocator {
public:
	typedef T                 value_type;
	typedef size_t            size_type;
	typedef ptrdiff_t         difference_type;
	typedef T*                pointer;
	typedef const T*          const_pointer;
	typedef T&                reference;
	typedef const T&          const_reference;

	typedef T                 rebind_type;

	allocator() {}
	allocator(const allocator&) {}
	template<class U> allocator(const allocator<U>&) {}
	template<class U> struct rebind { typedef allocator<U> other; };

	pointer allocate(size_type n, const void* = 0) {
		return (pointer)__stl_alloc_bytes(n * sizeof(T));
	}
	void deallocate(pointer p, size_type = 0) { __stl_free_bytes(p); }

	void construct(pointer p, const T& v) { new ((void*)p) T(v); }
	template<class U, class... Args>
	void construct(U* p, Args&&... args) { new ((void*)p) U(forward<Args>(args)...); }
	void destroy(pointer p) { (void)p; p->~T(); }
	template<class U> void destroy(U* p) { (void)p; p->~U(); }

	size_type max_size() const { return (size_type)-1 / sizeof(T); }
};

template<class T, class U>
inline bool operator==(const allocator<T>&, const allocator<U>&) { return true; }
template<class T, class U>
inline bool operator!=(const allocator<T>&, const allocator<U>&) { return false; }

/* =====================================================================
   uninitialised memory helpers

   A container grows in three steps: get bytes, build elements into them, drop
   the old ones.  These are the middle step, and the memcpy shortcut only
   applies when the type is trivially copyable.
   ===================================================================== */

template<class T, class... Args>
inline void __stl_construct(T* p, Args&&... args) {
	new ((void*)p) T(forward<Args>(args)...);
}
template<class T> inline void __stl_destroy(T* p) { p->~T(); }

template<class T>
inline void __stl_destroy_range(T* first, T* last) {
	if (!__stl_trivial<T>::value)
		for (; first != last; ++first) first->~T();
}

template<class T>
inline T* __stl_uninit_fill_n(T* first, size_t n, const T& v) {
	T* cur = first;
	for (; n > 0; --n, ++cur) __stl_construct(cur, v);
	return cur;
}

/* Build n elements by moving from src.  Plain byte copy when that is legal. */
template<class T>
inline T* __stl_uninit_move_n(T* first, T* src, size_t n) {
	if (__stl_trivial<T>::value) {
		if (n) memcpy((void*)first, (const void*)src, n * sizeof(T));
		return first + n;
	}
	T* cur = first;
	for (; n > 0; --n, ++cur, ++src) __stl_construct(cur, static_cast<T&&>(*src));
	return cur;
}

template<class T>
inline T* __stl_uninit_copy_n(T* first, const T* src, size_t n) {
	T* cur = first;
	for (; n > 0; --n, ++cur, ++src) __stl_construct(cur, *src);
	return cur;
}

/* Move a whole block, used by insert/erase to shift the tail.  memmove has to
   be used rather than memcpy because the ranges overlap. */
template<class T>
inline void __stl_move_block(T* dst, T* src, size_t n) {
	if (__stl_trivial<T>::value) {
		if (n) memmove((void*)dst, (const void*)src, n * sizeof(T));
		return;
	}
	if (dst < src) for (size_t i = 0; i < n; i++) dst[i] = static_cast<T&&>(src[i]);
	else for (size_t i = n; i > 0; i--) dst[i - 1] = static_cast<T&&>(src[i - 1]);
}

/* =====================================================================
   fill / copy helpers the containers and <algorithm> share
   ===================================================================== */

template<class T>
inline T* __stl_fill_n(T* first, size_t n, const T& v) {
	for (; n > 0; --n, ++first) *first = v;
	return first;
}

template<class Out, class In>
inline Out __stl_copy(Out out, In first, In last) {
	for (; first != last; ++out, ++first) *out = *first;
	return out;
}

