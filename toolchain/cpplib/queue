#ifndef PRIZM_CPPSHIM_QUEUE
#define PRIZM_CPPSHIM_QUEUE

/* <queue>.
 *
 * FIFO adaptor.  Same shape as stack: front/back/push/pop on the underlying
 * container, with the value category overloads spelled out because the
 * underlying push_back has two of them.
 */

#include <__stl_bits>
#include <deque>
#include <vector>
#include <list>
#include <type_traits>

namespace std {

template<class T, class C = deque<T> >
class queue {
public:
	typedef C                   container_type;
	typedef typename C::value_type value_type;
	typedef typename C::size_type  size_type;
	typedef typename C::reference  reference;
	typedef typename C::const_reference const_reference;

	queue() {}
	explicit queue(const C& c) : m_c(c) {}
	explicit queue(C&& c) : m_c(static_cast<C&&>(c)) {}

	template<class It, class = typename enable_if<!is_integral<It>::value>::type>
	queue(It first, It last) { for (; first != last; ++first) m_c.push_back(*first); }

	bool      empty() const { return m_c.empty(); }
	size_type size()  const { return m_c.size(); }

	reference       front()       { return m_c.front(); }
	const_reference front() const { return m_c.front(); }
	reference       back()        { return m_c.back(); }
	const_reference back()  const { return m_c.back(); }

	void push(const value_type& v) { m_c.push_back(v); }
	void push(value_type&& v)      { m_c.push_back(static_cast<value_type&&>(v)); }

	template<class... Args>
	reference emplace(Args&&... args) { return m_c.emplace_back(static_cast<Args&&>(args)...); }

	void pop() { m_c.pop_front(); }

	void swap(queue& o) { m_c.swap(o.m_c); }

	bool operator==(const queue& o) const { return m_c == o.m_c; }
	bool operator!=(const queue& o) const { return m_c != o.m_c; }
	bool operator< (const queue& o) const { return m_c <  o.m_c; }
	bool operator> (const queue& o) const { return m_c >  o.m_c; }
	bool operator<=(const queue& o) const { return m_c <= o.m_c; }
	bool operator>=(const queue& o) const { return m_c >= o.m_c; }

protected:
	C m_c;
};

template<class T, class C>
inline void swap(queue<T, C>& a, queue<T, C>& b) { a.swap(b); }

/* =====================================================================
   priority_queue
   ===================================================================== */

/* A binary heap over the underlying container.  The standard's ordering is
   "the largest element is on top", which is what a max-heap gives directly;
   pass greater<T> to flip it into a min-heap. */

template<class T, class C = vector<T>, class Cmp = less<typename C::value_type> >
class priority_queue {
public:
	typedef C    container_type;
	typedef typename C::value_type value_type;
	typedef typename C::size_type  size_type;
	typedef typename C::reference  reference;
	typedef typename C::const_reference const_reference;
	typedef Cmp  value_compare;

	priority_queue() : m_cmp() {}
	explicit priority_queue(const Cmp& c) : m_c(), m_cmp(c) {}
	priority_queue(const Cmp& c, const C& cont) : m_c(cont), m_cmp(c) {
		std::make_heap(m_c.begin(), m_c.end(), m_cmp);
	}
	priority_queue(const Cmp& c, C&& cont)
	    : m_c(static_cast<C&&>(cont)), m_cmp(c) {
		std::make_heap(m_c.begin(), m_c.end(), m_cmp);
	}

	template<class It, class = typename enable_if<!is_integral<It>::value>::type>
	priority_queue(It first, It last) : m_c(first, last), m_cmp() {
		std::make_heap(m_c.begin(), m_c.end(), m_cmp);
	}
	template<class It, class = typename enable_if<!is_integral<It>::value>::type>
	priority_queue(It first, It last, const Cmp& c) : m_c(first, last), m_cmp(c) {
		std::make_heap(m_c.begin(), m_c.end(), m_cmp);
	}

	bool      empty() const { return m_c.empty(); }
	size_type size()  const { return m_c.size(); }

	const_reference top() const { return m_c.front(); }

	void push(const value_type& v) {
		m_c.push_back(v);
		std::push_heap(m_c.begin(), m_c.end(), m_cmp);
	}
	void push(value_type&& v) {
		m_c.push_back(static_cast<value_type&&>(v));
		std::push_heap(m_c.begin(), m_c.end(), m_cmp);
	}

	template<class... Args>
	void emplace(Args&&... args) {
		m_c.emplace_back(static_cast<Args&&>(args)...);
		std::push_heap(m_c.begin(), m_c.end(), m_cmp);
	}

	void pop() {
		std::pop_heap(m_c.begin(), m_c.end(), m_cmp);
		m_c.pop_back();
	}

	void swap(priority_queue& o) {
		m_c.swap(o.m_c);
		Cmp t = m_cmp; m_cmp = o.m_cmp; o.m_cmp = t;
	}

protected:
	C   m_c;
	Cmp m_cmp;
};

template<class T, class C, class Cmp>
inline void swap(priority_queue<T, C, Cmp>& a, priority_queue<T, C, Cmp>& b) { a.swap(b); }

}  /* namespace std */

#endif
