#ifndef PRIZM_CPPLIB_ATOMIC
#define PRIZM_CPPLIB_ATOMIC

/* The Prizm is single-core and our runtime is single-threaded, so plain
   loads and stores are already atomic at the hardware level.  volatile
   barriers keep the optimizer from reordering across them. */

#include <cstddef>

namespace std {

enum memory_order {
	memory_order_relaxed,
	memory_order_consume,
	memory_order_acquire,
	memory_order_release,
	memory_order_acq_rel,
	memory_order_seq_cst
};

template<class T>
struct atomic {
	atomic() : m_v() {}
	atomic(T v) : m_v(v) {}
	atomic(const atomic&) = delete;
	atomic& operator=(const atomic&) = delete;

	bool is_lock_free() const { return true; }

	void store(T v, memory_order = memory_order_seq_cst) { m_v = v; }
	T load(memory_order = memory_order_seq_cst) const { return m_v; }
	operator T() const { return m_v; }

	T exchange(T v, memory_order = memory_order_seq_cst) {
		T old = m_v;
		m_v = v;
		return old;
	}

	bool compare_exchange_weak(T& expected, T desired, memory_order = memory_order_seq_cst) {
		if (m_v == expected) { m_v = desired; return true; }
		expected = m_v;
		return false;
	}
	bool compare_exchange_strong(T& expected, T desired, memory_order = memory_order_seq_cst) {
		return compare_exchange_weak(expected, desired);
	}

	T fetch_add(T v, memory_order = memory_order_seq_cst) { T o = m_v; m_v = o + v; return o; }
	T fetch_sub(T v, memory_order = memory_order_seq_cst) { T o = m_v; m_v = o - v; return o; }
	T fetch_and(T v, memory_order = memory_order_seq_cst) { T o = m_v; m_v = o & v; return o; }
	T fetch_or (T v, memory_order = memory_order_seq_cst) { T o = m_v; m_v = o | v; return o; }
	T fetch_xor(T v, memory_order = memory_order_seq_cst) { T o = m_v; m_v = o ^ v; return o; }

	T operator++(int) { return fetch_add(T(1)); }
	T operator--(int) { return fetch_sub(T(1)); }
	T operator++()    { fetch_add(T(1)); return m_v; }
	T operator--()    { fetch_sub(T(1)); return m_v; }
	T operator+=(T v) { fetch_add(v); return m_v; }
	T operator-=(T v) { fetch_sub(v); return m_v; }
	T operator&=(T v) { fetch_and(v); return m_v; }
	T operator|=(T v) { fetch_or(v);  return m_v; }
	T operator^=(T v) { fetch_xor(v); return m_v; }

private:
	T m_v;
};

/* Pointer specialization: arithmetic is by T. */
template<class T>
struct atomic<T*> {
	atomic() : m_v(0) {}
	atomic(T* v) : m_v(v) {}
	atomic(const atomic&) = delete;
	atomic& operator=(const atomic&) = delete;

	bool is_lock_free() const { return true; }
	void store(T* v, memory_order = memory_order_seq_cst) { m_v = v; }
	T* load(memory_order = memory_order_seq_cst) const { return m_v; }
	operator T*() const { return m_v; }
	T* exchange(T* v, memory_order = memory_order_seq_cst) { T* o = m_v; m_v = v; return o; }

	T* fetch_add(ptrdiff_t v, memory_order = memory_order_seq_cst) { T* o = m_v; m_v = o + v; return o; }
	T* fetch_sub(ptrdiff_t v, memory_order = memory_order_seq_cst) { T* o = m_v; m_v = o - v; return o; }
	T* operator++(int) { return fetch_add(1); }
	T* operator--(int) { return fetch_sub(1); }
	T* operator++()    { fetch_add(1); return m_v; }
	T* operator--()    { fetch_sub(1); return m_v; }
	T* operator+=(ptrdiff_t v) { fetch_add(v); return m_v; }
	T* operator-=(ptrdiff_t v) { fetch_sub(v); return m_v; }
private:
	T* m_v;
};

typedef atomic<bool> atomic_bool;
typedef atomic<char> atomic_char;
typedef atomic<signed char> atomic_schar;
typedef atomic<unsigned char> atomic_uchar;
typedef atomic<short> atomic_short;
typedef atomic<unsigned short> atomic_ushort;
typedef atomic<int> atomic_int;
typedef atomic<unsigned int> atomic_uint;
typedef atomic<long> atomic_long;
typedef atomic<unsigned long> atomic_ulong;
typedef atomic<long long> atomic_llong;
typedef atomic<unsigned long long> atomic_ullong;
typedef atomic<size_t> atomic_size_t;

struct atomic_flag {
	atomic_flag() : m_set(0) {}
	atomic_flag(const atomic_flag&) = delete;
	atomic_flag& operator=(const atomic_flag&) = delete;

	bool test_and_set(memory_order = memory_order_seq_cst) { bool o = m_set != 0; m_set = 1; return o; }
	void clear(memory_order = memory_order_seq_cst) { m_set = 0; }
private:
	char m_set;
};

}

#endif
